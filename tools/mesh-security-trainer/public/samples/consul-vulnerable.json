      "cert_file": "",
      "key_file": "",
      "tls_min_version": "TLSv1.0",
      "tls_cipher_suites": "",
      "tls_prefer_server_cipher_suites": false
    },
    "internal_rpc": {
      "verify_incoming": false,
      "verify_server_hostname": false
    }
  },
  
  "acl": {
    "enabled": false,
    "default_policy": "allow",
    "enable_token_persistence": true,
    "enable_token_replication": false,
    "policy_ttl": "30s",
    "role_ttl": "30s",
    "token_ttl": "30s",
    "down_policy": "allow"
