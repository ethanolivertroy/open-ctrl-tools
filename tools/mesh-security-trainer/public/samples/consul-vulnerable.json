{
  "mesh_type": "consul",
  "datacenter": "dc1",
  "primary_datacenter": "dc1",
  "node_name": "consul-server-1",
  
  "connect": {
    "enabled": true,
    "enable_mesh_gateway_wan_federation": false,
    "ca_provider": "consul",
    "ca_config": {
      "private_key_type": "rsa",
      "private_key_bits": 1024,
      "leaf_cert_ttl": "8760h",
      "intermediate_cert_ttl": "87600h",
      "root_cert_ttl": "87600h",
      "csr_max_concurrent": 0,
      "csr_max_per_second": 0
    }
  },
  
  "tls": {
    "defaults": {
      "verify_incoming": false,
      "verify_outgoing": false,
      "verify_server_hostname": false,
      "ca_file": "",
