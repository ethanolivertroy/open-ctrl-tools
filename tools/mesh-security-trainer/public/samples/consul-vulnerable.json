      "enabled": false,
      "static": {
        "oidc_discovery_url": "",
        "oidc_discovery_ca_cert": "",
        "bound_issuer": "",
        "bound_audiences": [],
        "claim_mappings": {},
        "claim_assertions": []
      }
    }
  },
  
  "auto_encrypt": {
    "allow_tls": false,
    "tls": false,
    "dns_san": [],
    "ip_san": []
  },
  
  "gossip_lan": {
    "gossip_interval": "1s",
    "gossip_nodes": 3,
    "probe_interval": "1s",
    "probe_timeout": "500ms",
    "suspicion_mult": 4,
    "retransmit_mult": 4
