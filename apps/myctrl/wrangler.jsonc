{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myctrl-tools",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
