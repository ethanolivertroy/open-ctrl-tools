---
/**
 * AIPreview - Homepage section 03 for AI-native compliance features
 *
 * Glassmorphism card with a 2x2 feature grid showing API, Ask AI,
 * View Builder, and Agent Tools (coming soon).
 */
---

<section class="space-y-6 scroll-reveal">
  <div class="max-w-2xl">
    <h2 class="text-2xl md:text-3xl font-semibold uppercase tracking-[0.04em]">Built for AI workflows</h2>
  </div>

  <div
    class="ai-card group overflow-hidden rounded-2xl border"
  >
    <div class="p-4 sm:p-6 md:p-8">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Left: content -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[var(--ctp-mauve)] shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
              <path d="M9 13a4.5 4.5 0 0 0 3-4"/>
              <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/>
              <path d="M3.477 10.896a4 4 0 0 1 .585-.396"/>
              <path d="M6 18a4 4 0 0 1-1.967-.516"/>
              <path d="M12 13h4"/>
              <path d="M12 18h6a2 2 0 0 1 2 2v1"/>
              <path d="M12 8h8"/>
              <path d="M16 8V5a2 2 0 0 1 2-2"/>
              <circle cx="16" cy="13" r=".5"/>
              <circle cx="18" cy="3" r=".5"/>
              <circle cx="20" cy="21" r=".5"/>
              <circle cx="20" cy="8" r=".5"/>
            </svg>
            <h3 class="text-xl font-bold tracking-tight">
              From search to automation
            </h3>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            Access controls via REST API, ask AI about any control inline, or build custom compliance views with natural language. Agent tools coming soon.
          </p>

          <div class="flex flex-wrap items-center gap-6 text-sm">
            <span>
              <span class="text-foreground font-semibold">5</span>
              <span class="text-muted-foreground ml-1">API endpoints</span>
            </span>
            <span>
              <span class="text-foreground font-semibold">AI-powered</span>
              <span class="text-muted-foreground ml-1">views</span>
            </span>
            <span class="text-muted-foreground">
              <kbd class="px-1.5 py-0.5 text-xs rounded border border-border/50 bg-background/50 font-mono">&#8984;J</kbd>
              anywhere
            </span>
          </div>

          <div class="flex flex-wrap gap-2 pt-2">
            <a href="/developers/api" class="ai-pill ai-pill-cta">
              Explore API &rarr;
            </a>
            <a href="/build" class="ai-pill ai-pill-cta">
              Build a View &rarr;
            </a>
          </div>
        </div>

        <!-- Right: 2x2 feature grid (desktop only) -->
        <div class="hidden md:flex items-center justify-center">
          <div class="grid grid-cols-2 gap-3 w-full max-w-xs">
            <a href="/developers/api" class="ai-feature-item group/item">
              <div class="ai-feature-icon">
                <svg class="w-4 h-4 text-[var(--ctp-blue)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m16 18 2 2 4-4"/>
                  <path d="M21 12V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/>
                  <path d="m7.5 4.27 9 5.15"/>
                  <polyline points="3.29 7 12 12 20.71 7"/>
                  <line x1="12" x2="12" y1="22" y2="12"/>
                </svg>
              </div>
              <span class="ai-feature-label">REST API</span>
              <span class="ai-feature-meta">5 endpoints</span>
            </a>

            <a href="/frameworks/nist-800-53-r5/ac-1" class="ai-feature-item group/item">
              <div class="ai-feature-icon">
                <svg class="w-4 h-4 text-[var(--ctp-green)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  <path d="M8 10h.01"/>
                  <path d="M12 10h.01"/>
                  <path d="M16 10h.01"/>
                </svg>
              </div>
              <span class="ai-feature-label">Ask AI</span>
              <span class="ai-feature-meta">On every control</span>
            </a>

            <a href="/build" class="ai-feature-item group/item">
              <div class="ai-feature-icon">
                <svg class="w-4 h-4 text-[var(--ctp-peach)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2"/>
                  <path d="M7 7h3v3H7z"/>
                  <path d="M14 7h3"/>
                  <path d="M14 11h3"/>
                  <path d="M7 14h10v3H7z"/>
                </svg>
              </div>
              <span class="ai-feature-label">View Builder</span>
              <span class="ai-feature-meta">Natural language</span>
            </a>

            <span class="ai-feature-item ai-feature-coming-soon">
              <div class="ai-feature-icon">
                <svg class="w-4 h-4 text-[var(--ctp-mauve)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8"/>
                  <rect width="16" height="12" x="4" y="8" rx="2"/>
                  <path d="M2 14h2"/>
                  <path d="M20 14h2"/>
                  <path d="M15 13v2"/>
                  <path d="M9 13v2"/>
                </svg>
              </div>
              <span class="ai-feature-label">Agent Tools</span>
              <span class="ai-feature-badge">Coming soon</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-card {
    background: color-mix(in srgb, var(--ctp-mantle) 80%, transparent);
    border-color: color-mix(in srgb, var(--ctp-overlay0) 22%, transparent);
    transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
  }

  .ai-card:hover {
    border-color: color-mix(in srgb, var(--ctp-text) 35%, transparent);
    background: var(--ctp-mantle);
  }

  .ai-glow {
    display: none;
  }

  /* CTA pills */
  .ai-pill {
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 0.375rem;
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 35%, transparent);
    background: transparent;
    transition: border-color 0.3s, color 0.3s;
  }

  .ai-pill-cta {
    text-decoration: none;
    color: var(--ctp-subtext0);
  }

  .ai-pill-cta:hover {
    border-color: color-mix(in srgb, var(--ctp-text) 30%, transparent);
    color: var(--ctp-text);
  }

  /* 2x2 feature grid items */
  .ai-feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 15%, transparent);
    background: color-mix(in srgb, var(--ctp-surface0) 30%, transparent);
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s;
  }

  a.ai-feature-item:hover {
    border-color: color-mix(in srgb, var(--ctp-text) 30%, transparent);
    background: color-mix(in srgb, var(--ctp-surface0) 50%, transparent);
  }

  .ai-feature-coming-soon {
    opacity: 0.6;
    cursor: default;
  }

  .ai-feature-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1;
  }

  .ai-feature-meta {
    font-size: 0.6875rem;
    color: var(--color-muted-foreground);
    line-height: 1;
  }

  .ai-feature-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ctp-subtext0);
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 35%, transparent);
    background: transparent;
    line-height: 1.4;
  }

  /* Section number (inline — Astro scopes these) */
</style>
