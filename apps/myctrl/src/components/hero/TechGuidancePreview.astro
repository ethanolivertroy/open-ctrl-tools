---
/**
 * TechGuidancePreview - Homepage section for technology implementation guidance
 *
 * Glassmorphism card with a real code preview showing what users get.
 *
 * EXEMPTION from the "all code blocks render via @pierre/diffs" rule
 * (see CLAUDE.md): this snippet is a hand-styled marketing mock whose
 * colors track every site theme through the `--ctp-*` variables, which
 * StaticCode cannot do (it bakes a fixed dark/light Shiki pair). Do not
 * copy this pattern for real code rendering.
 */
---

<section class="space-y-6 scroll-reveal">
  <div class="max-w-2xl">
    <h2 class="text-2xl md:text-3xl font-semibold uppercase tracking-[0.04em]">From requirement to running config</h2>
  </div>

  <a
    href="/guidance"
    class="tech-card group block overflow-hidden rounded-2xl border"
  >
    <div class="p-4 sm:p-6 md:p-8">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Left: content -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[var(--ctp-peach)] shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
            <h3 class="text-xl font-bold tracking-tight">
              Technology Guidance
            </h3>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            Configuration examples and verification tests for every major cloud platform. Go from control requirement to implementation with guidance from NIST, CIS, and cloud providers.
          </p>

          <div class="flex items-center gap-6 text-sm">
            <span>
              <span class="text-foreground font-semibold">30+</span>
              <span class="text-muted-foreground ml-1">technologies</span>
            </span>
            <span>
              <span class="text-foreground font-semibold">500+</span>
              <span class="text-muted-foreground ml-1">verification commands</span>
            </span>
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            <span class="tech-pill">AWS</span>
            <span class="tech-pill">Azure</span>
            <span class="tech-pill">GCP</span>
            <span class="tech-pill">Kubernetes</span>
            <span class="tech-pill">Oracle Cloud</span>
            <span class="tech-pill text-muted-foreground">+25 more</span>
          </div>

          <div class="flex items-center gap-2 pt-2">
            <span class="tech-pill">
              Explore Guidance →
            </span>
          </div>
        </div>

        <!-- Right: code preview (theme-tracking art-direction mock; exempt
             from the StaticCode mandate - see component comment above) -->
        <div class="hidden md:block">
          <div class="code-preview rounded-xl overflow-hidden">
            <div class="code-header flex items-center justify-between px-4 py-2.5">
              <span class="text-xs font-mono text-muted-foreground/80">aws-iam-verification.sh</span>
              <span class="text-xs text-muted-foreground/50">bash</span>
            </div>
            <pre class="p-4 text-[13px] leading-relaxed overflow-x-auto"><code><span class="code-comment"># Check IAM credential report for MFA status</span>
<span class="code-cmd">aws</span> iam generate-credential-report
<span class="code-cmd">aws</span> iam get-credential-report <span class="code-dim">\</span>
    --output text <span class="code-dim">\</span>
    --query <span class="code-str">'Content'</span> <span class="code-dim">\</span>
    | base64 -d | cut -d, -f1,4

<span class="code-comment"># List users without MFA</span>
<span class="code-cmd">aws</span> iam list-users <span class="code-dim">\</span>
    --query <span class="code-str">'Users[*].UserName'</span> <span class="code-dim">\</span>
    --output text | xargs -I {} <span class="code-dim">\</span>
    <span class="code-cmd">aws</span> iam list-mfa-devices <span class="code-dim">\</span>
    --user-name {}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </a>
</section>

<style>
  .tech-card {
    background: color-mix(in srgb, var(--ctp-mantle) 80%, transparent);
    border-color: color-mix(in srgb, var(--ctp-overlay0) 22%, transparent);
    transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
  }

  .tech-card:hover {
    border-color: color-mix(in srgb, var(--ctp-text) 35%, transparent);
    background: var(--ctp-mantle);
  }

  .tech-glow {
    display: none;
  }

  .tech-pill {
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 0.375rem;
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 35%, transparent);
    background: transparent;
    color: var(--ctp-subtext0);
    transition: border-color 0.3s, color 0.3s;
  }

  .tech-card:hover .tech-pill {
    border-color: color-mix(in srgb, var(--ctp-text) 30%, transparent);
    color: var(--ctp-text);
  }

  /* Code preview — themed to match the glassmorphism, not a fake terminal */
  .code-preview {
    background: color-mix(in srgb, var(--ctp-crust) 90%, transparent);
    border: 1px solid color-mix(in srgb, var(--ctp-surface0) 50%, transparent);
  }

  .code-header {
    border-bottom: 1px solid color-mix(in srgb, var(--ctp-surface0) 40%, transparent);
    background: color-mix(in srgb, var(--ctp-mantle) 60%, transparent);
  }

  .code-preview pre {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
  }

  .code-preview code {
    display: block;
    color: var(--ctp-text);
  }

  .code-comment { color: var(--ctp-overlay1); }
  .code-cmd { color: var(--ctp-sapphire); }
  .code-str { color: var(--ctp-green); }
  .code-dim { color: var(--ctp-overlay0); }

  /* Section number (inline — Astro scopes these) */
</style>
