---
/**
 * FilterPage — shared renderer for the per-framework filter routes
 * (/frameworks/<id>/baseline/low, /frameworks/<id>/severity/cat-i, ...).
 * All framework-specific text, badges, and control getters come from
 * FILTER_CONFIGS in ./filter-config.ts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ControlCardCompact } from '@/components/controls/ControlCard';
import { ExportButton } from '@/components/export/ExportButton';
import { getStats, getFamilyName, getFrameworkConfig } from '@/data/controls';
import { FILTER_CONFIGS } from './filter-config';

interface Props {
  frameworkId: string;
  /** Current URL param value, e.g. 'low', 'cat-i', '1' */
  param: string;
}

const { frameworkId, param } = Astro.props;

const filterConfig = FILTER_CONFIGS[frameworkId];
const level = filterConfig.levels.find((l) => l.param === param)!;
const stats = getStats(frameworkId);
const frameworkConfig = getFrameworkConfig(frameworkId);

const allControls = filterConfig.getControls(frameworkId, param);

// Group by family
const familyGroups = new Map<string, typeof allControls>();
for (const control of allControls) {
  const group = familyGroups.get(control.family) || [];
  group.push(control);
  familyGroups.set(control.family, group);
}
const families = Array.from(familyGroups.keys()).sort(
  filterConfig.numericFamilySort ? (a, b) => parseInt(a) - parseInt(b) : undefined,
);

const statValue = (key: (typeof level)['statKey']) => stats[key];
---

<BaseLayout title={level.pageTitle} showSidebar={true} frameworkId={frameworkId}>
  <div class="space-y-8">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        {filterConfig.breadcrumbParent ? (
          <a href={filterConfig.breadcrumbParent.href} class="hover:text-foreground transition-colors">
            {filterConfig.breadcrumbParent.label}
          </a>
        ) : (
          <span>Frameworks</span>
        )}
        <span>/</span>
        <a href={`/frameworks/${frameworkId}`} class="hover:text-foreground transition-colors">
          {filterConfig.breadcrumbFrameworkLabel}
        </a>
        <span>/</span>
        <span class="text-foreground">{level.breadcrumbLabel}</span>
      </div>

      {filterConfig.exportFilterKey ? (
        <div class="flex items-center justify-between gap-4">
          <h1 class="text-3xl font-bold tracking-tight">
            {filterConfig.heading} <span class="text-primary">{filterConfig.headingAccent}</span>
          </h1>
          <ExportButton
            client:idle
            controls={allControls}
            config={frameworkConfig}
            filters={{ [filterConfig.exportFilterKey]: param }}
          />
        </div>
      ) : (
        <h1 class="text-3xl font-bold tracking-tight">
          {filterConfig.heading} <span class="text-primary">{filterConfig.headingAccent}</span>
        </h1>
      )}

      <p class="text-muted-foreground">
        {filterConfig.subtitle}
      </p>

      <!-- Quick stats / Filter badges -->
      <div class="flex flex-wrap gap-3 text-sm pt-2">
        <a
          href={`/frameworks/${frameworkId}`}
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg border transition-all duration-200 bg-muted border-transparent text-muted-foreground hover:border-muted-foreground/30"
        >
          <span class="font-mono">{stats.total}</span>
          <span>All</span>
        </a>
        {filterConfig.levels.map((l) => {
          const count = statValue(l.statKey);
          if (l.hideBadgeWhenEmpty && !(count !== undefined && count > 0)) return null;
          return (
            <a
              href={`/frameworks/${frameworkId}/${filterConfig.dimension}/${l.param}`}
              class:list={[
                'flex items-center gap-2 px-3 py-1.5 rounded-lg border transition-all duration-200',
                l.param === param ? l.badgeActiveClass : l.badgeInactiveClass,
              ]}
            >
              <span class="font-mono">{count}</span>
              <span>{l.badgeLabel}</span>
            </a>
          );
        })}
      </div>

      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <span>Showing {allControls.length} {filterConfig.itemNoun} {filterConfig.showingPreposition}</span>
        <span class="font-semibold" style={`color: ${level.color}`}>{level.displayName}</span>
        {filterConfig.showingSuffix && <span>{filterConfig.showingSuffix}</span>}
      </div>

      {level.description && (
        <p class="text-sm text-muted-foreground italic">
          {level.description}
        </p>
      )}
    </header>

    <!-- Control Families -->
    <section class="space-y-8">
      {families.map((family) => {
        const controls = familyGroups.get(family) || [];
        const familyName = getFamilyName(frameworkId, family);

        return (
          <div class="space-y-4" id={`${filterConfig.familyAnchorPrefix ?? ''}${family.toLowerCase()}`}>
            <h2 class="text-xl font-semibold flex items-center gap-3 sticky top-16 bg-background py-2 z-10">
              <span class="font-mono text-primary">{family}</span>
              <span class="text-muted-foreground">—</span>
              <span>{familyName}</span>
              <span class="text-sm text-muted-foreground font-normal">
                ({controls.length} {filterConfig.itemNoun})
              </span>
            </h2>

            <div class="space-y-2">
              {controls.map((control) => (
                <ControlCardCompact control={control} />
              ))}
            </div>
          </div>
        );
      })}
    </section>

    {filterConfig.emptyState && allControls.length === 0 && (
      <div class="text-center py-12 text-muted-foreground">
        <p>{filterConfig.emptyState.message(param)}</p>
        {filterConfig.emptyState.hint && (
          <p class="text-sm mt-2">{filterConfig.emptyState.hint}</p>
        )}
      </div>
    )}
  </div>
</BaseLayout>
