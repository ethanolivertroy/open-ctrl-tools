---
import type { RscServiceData, RscContentBlock } from '@/data/types';
import { slugify } from '@/data/controls';
import StaticCode from '@/components/ui/StaticCode.astro';

interface Props {
  data: RscServiceData;
}

const { data } = Astro.props;

const applicableReqs = data.requirements.filter((r) => r.applicable);
const naReqs = data.requirements.filter((r) => !r.applicable);

function formatImpactLevel(level: string): string {
  return level.replace('fips-199-', '').toUpperCase();
}

// Count total controls across all applicable requirements
const totalControlIds = new Set(applicableReqs.flatMap((r) => r.controlIds));
---

{/* AWS Official provenance banner */}
<div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-4 sm:p-5 space-y-3">
  <div class="flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
    </svg>
    <div class="space-y-1">
      <p class="text-sm font-semibold text-foreground">AWS Official Secure Configuration</p>
      <p class="text-xs text-muted-foreground leading-relaxed">
        Based on the <strong>AWS Responsibility Summary and Customer Configuration</strong> documentation submitted to the FedRAMP Program Management Office.
        This is the official AWS-authored guidance for configuring <strong>{data.serviceName}</strong> to meet FedRAMP security requirements.
      </p>
    </div>
  </div>
</div>

{/* Governance metadata header */}
<div class="rounded-lg border border-border bg-card p-4 sm:p-5 space-y-4">
  <div class="flex flex-wrap items-center gap-2">
    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-500/10 text-red-500 border border-red-500/20">FedRAMP RSC</span>
    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-600/10 text-amber-600 border border-amber-600/20">AWS Official</span>
    <span class="px-2.5 py-1 text-xs rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">
      {applicableReqs.length} applicable {applicableReqs.length === 1 ? 'requirement' : 'requirements'}
    </span>
    {totalControlIds.size > 0 && (
      <span class="px-2.5 py-1 text-xs rounded-full bg-purple-500/10 text-purple-500 border border-purple-500/20">
        {totalControlIds.size} {totalControlIds.size === 1 ? 'FedRAMP control' : 'FedRAMP controls'}
      </span>
    )}
    {data.securitySensitivity && (
      <span class="px-2.5 py-1 text-xs rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20">
        {data.securitySensitivity.toUpperCase()} sensitivity
      </span>
    )}
    <span class="text-xs text-muted-foreground ml-auto">
      Last updated: {data.lastUpdated}
    </span>
  </div>

  {data.impactLevels && (
    <div class="rounded-md border border-border/60 bg-muted/20 px-3 py-2">
      <div class="flex flex-wrap gap-4 text-xs">
        <span class="text-muted-foreground font-medium">FIPS 199 Impact Levels:</span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-red-500/70"></span>
          Confidentiality: <strong class="text-foreground">{formatImpactLevel(data.impactLevels.confidentiality)}</strong>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-500/70"></span>
          Integrity: <strong class="text-foreground">{formatImpactLevel(data.impactLevels.integrity)}</strong>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-green-500/70"></span>
          Availability: <strong class="text-foreground">{formatImpactLevel(data.impactLevels.availability)}</strong>
        </span>
      </div>
    </div>
  )}

  {data.overview && (
    <div class="text-sm text-muted-foreground leading-relaxed [&_a]:text-primary [&_a]:underline [&_a:hover]:text-primary/80 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-muted [&_code]:text-xs [&_code]:font-mono [&_strong]:text-foreground" set:html={data.overview} />
  )}
</div>

{/* Requirements table of contents */}
{applicableReqs.length > 1 && (
  <nav class="space-y-3" aria-label="Requirements navigation">
    <h2 class="text-lg font-semibold flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
      </svg>
      FedRAMP Requirements
    </h2>
    <p class="text-sm text-muted-foreground">
      Jump to a specific requirement section. Each requirement maps to one or more FedRAMP Rev 5 controls.
    </p>
    <div class="grid gap-2 sm:grid-cols-2">
      {applicableReqs.map((req) => (
        <a
          href={`#${req.id.toLowerCase()}`}
          class="flex items-center gap-3 rounded-md border border-border/60 bg-muted/30 px-3 py-2.5 hover:bg-muted/60 hover:border-primary/30 transition-all text-sm group"
        >
          <span class="font-mono text-xs text-primary shrink-0 group-hover:text-primary/80">{req.id}</span>
          <span class="text-foreground truncate">{req.title}</span>
          {req.controlIds.length > 0 && (
            <span class="text-xs text-muted-foreground ml-auto shrink-0 tabular-nums">
              {req.controlIds.length} {req.controlIds.length === 1 ? 'control' : 'controls'}
            </span>
          )}
        </a>
      ))}
    </div>
    {naReqs.length > 0 && (
      <p class="text-xs text-muted-foreground">
        {naReqs.length} {naReqs.length === 1 ? 'requirement' : 'requirements'} not applicable to this service: {naReqs.map((r) => r.id).join(', ')}
      </p>
    )}
  </nav>
)}

{/* Requirement content sections */}
{applicableReqs.map((req, reqIndex) => (
  <section id={req.id.toLowerCase()} class="space-y-5 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-3 border-b-2 border-primary/20">
      <div class="flex items-center gap-3">
        <span class="font-mono text-sm px-2.5 py-1 rounded bg-primary/10 text-primary font-semibold">{req.id}</span>
        <h2 class="text-lg sm:text-xl font-semibold">{req.title}</h2>
      </div>
      {req.controlIds.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {req.controlIds.map((cid) => (
            <a
              href={`/frameworks/fedramp-rev5/${slugify(cid)}`}
              class="px-2 py-0.5 text-xs rounded-full bg-primary/10 text-primary hover:bg-primary/20 transition-colors font-mono"
            >
              {cid}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="space-y-4 rsc-content">
      {req.blocks.map((block) => {
        if (block.type === 'heading') {
          const Tag = `h${block.level}` as 'h2' | 'h3' | 'h4';
          const sizeClass = block.level === 2
            ? 'text-lg font-semibold mt-6 mb-2'
            : block.level === 3
              ? 'text-base font-semibold mt-4 mb-1'
              : 'text-sm font-semibold text-muted-foreground uppercase tracking-wide mt-4 mb-1';
          return <Tag class={`${sizeClass} text-foreground`}>{block.text}</Tag>;
        }

        if (block.type === 'text') {
          return <div class="text-sm text-muted-foreground leading-relaxed [&_a]:text-primary [&_a]:underline [&_a:hover]:text-primary/80 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-muted [&_code]:text-xs [&_code]:font-mono [&_code]:border [&_code]:border-border/50 [&_strong]:text-foreground" set:html={block.html} />;
        }

        if (block.type === 'code') {
          return (
            <div class="rounded-lg border border-border bg-card overflow-hidden">
              <div class="flex items-center justify-between px-3 py-1.5 bg-muted/50 border-b border-border">
                <span class="text-xs text-muted-foreground font-mono">{block.language}</span>
                <button
                  data-copy={block.code}
                  class="copy-btn p-1 rounded hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
                  title="Copy to clipboard"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                  </svg>
                </button>
              </div>
              <StaticCode code={block.code} language={block.language} />
            </div>
          );
        }

        if (block.type === 'list') {
          const ListTag = block.ordered ? 'ol' : 'ul';
          return (
            <ListTag class={`text-sm text-muted-foreground space-y-1.5 ${block.ordered ? 'list-decimal' : 'list-disc'} list-outside ml-5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-muted [&_code]:text-xs [&_code]:font-mono [&_code]:border [&_code]:border-border/50 [&_li]:leading-relaxed`}>
              {block.items.map((item) => (
                <li set:html={item} />
              ))}
            </ListTag>
          );
        }

        if (block.type === 'table') {
          return (
            <div class="rounded-lg border border-border overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-muted [&_code]:text-xs [&_code]:font-mono [&_code]:border [&_code]:border-border/50">
                  {block.headers && (
                    <thead class="bg-muted/50">
                      <tr>
                        {block.headers.map((h) => (
                          <th class="px-3 py-2.5 text-left text-xs font-semibold text-foreground whitespace-nowrap" set:html={h} />
                        ))}
                      </tr>
                    </thead>
                  )}
                  <tbody class="divide-y divide-border">
                    {block.rows.map((row, rowIndex) => (
                      <tr class={rowIndex % 2 === 1 ? 'bg-muted/20' : ''}>
                        {row.map((cell, cellIndex) => (
                          <td class={`px-3 py-2 text-muted-foreground ${cellIndex === 0 ? 'font-medium text-foreground' : ''}`} set:html={cell} />
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          );
        }

        return null;
      })}
    </div>

    {/* Visual separator between requirements */}
    {reqIndex < applicableReqs.length - 1 && (
      <div class="pt-2">
        <div class="border-t border-border/50"></div>
      </div>
    )}
  </section>
))}
