---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RscSectionContent from './RscSectionContent.astro';
import StaticCode from '@/components/ui/StaticCode.astro';
import { techCommandLanguage } from '@/components/guidance/tech-command-language';
import { AuthoritativeSourceCard } from '@/components/guidance/AuthoritativeSourceCard';
import { GitHubRepoCard } from '@/components/guidance/GitHubRepoCard';
import { getFrameworkConfig } from '@/data/frameworks';
import { slugify, hasFrameworkData } from '@/data/controls';
import { getTechnologyById, getTechnologyPath, getSectionContent, AWS_RSC_DATA } from '@/data/technology-guides';
import type { TechCommandType, TechnologyGuide, TechnologyGuideSection, TechnologyCategoryMeta } from '@/data/types';

interface Props {
  tech: TechnologyGuide;
  section: TechnologyGuideSection;
  categoryMeta?: TechnologyCategoryMeta;
  baseHref?: string;
  baseLabel?: string;
  categoryHref?: string;
}

const {
  tech,
  section,
  categoryMeta,
  baseHref = '/guidance',
  baseLabel = 'Technology Guidance',
  categoryHref,
} = Astro.props;

const resolvedCategoryHref = categoryHref ?? categoryMeta?.path;
const techPath = getTechnologyPath(tech);
const rscData = section.rscServiceId ? AWS_RSC_DATA[section.rscServiceId] : null;
const content = !rscData ? getSectionContent(tech, section) : null;
const isAwsRsc = !!rscData;
const rscServiceName = rscData?.serviceName ?? section.title;

const COMMAND_TYPES: Record<TechCommandType, { label: string; color: string }> = {
  cli: { label: 'CLI', color: 'bg-green-500/10 text-green-500 border-green-500/20' },
  api: { label: 'API', color: 'bg-blue-500/10 text-blue-500 border-blue-500/20' },
  query: { label: 'Query', color: 'bg-purple-500/10 text-purple-500 border-purple-500/20' },
  config: { label: 'Config', color: 'bg-orange-500/10 text-orange-500 border-orange-500/20' },
};

const commands = content?.commands ?? [];
const hasCommandGroups = commands.some((cmd) => cmd.group);
const groupedCommands = commands.reduce(
  (groups, cmd) => {
    const label = cmd.group ?? 'General';
    const existing = groups.find((group) => group.label === label);
    if (existing) {
      existing.commands.push(cmd);
    } else {
      groups.push({ label, commands: [cmd] });
    }
    return groups;
  },
  [] as { label: string; commands: typeof commands }[],
);

// Prev/next section navigation
const sections = tech.sections ?? [];
const currentIndex = sections.findIndex((s) => s.id === section.id);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;

// Fetch GitHub repo metadata at build time
const githubRepoData = tech.githubRepos
  ? await Promise.all(
      tech.githubRepos.map(async (fullName) => {
        const [owner, repo] = fullName.split('/');
        try {
          const res = await fetch(`https://api.github.com/repos/${fullName}`, {
            headers: import.meta.env.GH_TOKEN
              ? { Authorization: `token ${import.meta.env.GH_TOKEN}` }
              : {},
          });
          if (!res.ok) return { owner, repo };
          const data = await res.json();
          return {
            owner: data.owner.login,
            repo: data.name,
            description: data.description,
            language: data.language,
            stars: data.stargazers_count,
            forks: data.forks_count,
          };
        } catch {
          return { owner, repo };
        }
      })
    )
  : [];
---

<BaseLayout
  title={isAwsRsc ? `${rscServiceName} — AWS Official Secure Configuration` : `${section.title} - ${tech.name} Security Guidance`}
  description={isAwsRsc ? `Official AWS FedRAMP secure configuration guidance for ${rscServiceName}. ${section.description}` : `${section.description} Security guidance for ${tech.name}.`}
  showSidebar={false}
>
  <div class="space-y-8 sm:space-y-10">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground flex-wrap">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href={baseHref} class="hover:text-foreground transition-colors">{baseLabel}</a>
        <span>/</span>
        {categoryMeta && (
          <>
            {resolvedCategoryHref ? (
              <a href={resolvedCategoryHref} class="hover:text-foreground transition-colors">
                {categoryMeta.name}
              </a>
            ) : (
              <span>{categoryMeta.name}</span>
            )}
            <span>/</span>
          </>
        )}
        <a href={techPath} class="hover:text-foreground transition-colors">{tech.name}</a>
        <span>/</span>
        <span class="text-foreground">{section.title}</span>
      </nav>

      <div class="space-y-2">
        {isAwsRsc ? (
          <>
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-600/10 text-amber-600 border border-amber-600/20">AWS Official</span>
              <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-red-500/10 text-red-500 border border-red-500/20">FedRAMP RSC</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{rscServiceName} Secure Configuration</h1>
            <p class="text-lg text-muted-foreground max-w-2xl">{section.description}</p>
          </>
        ) : (
          <>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{section.title}</h1>
            <p class="text-lg text-muted-foreground max-w-2xl">{section.description}</p>
          </>
        )}
      </div>

      {isAwsRsc ? (
        <div class="p-4 rounded-lg border border-blue-500/20 bg-blue-500/5">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-sm text-muted-foreground">
              This page presents data from the <strong class="text-foreground">AWS FedRAMP Responsibility Summary and Customer Configuration (RSC)</strong> package. Content is derived from OSCAL-formatted component definitions submitted by AWS.
            </p>
          </div>
        </div>
      ) : (
        <div class="p-4 rounded-lg warning-banner">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 warning-banner-icon shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="text-sm warning-banner-text">
              <strong>Under Construction:</strong> This guidance is being actively developed and verified. Content may change.
            </p>
          </div>
        </div>
      )}
    </header>

    {rscData && (
      <RscSectionContent data={rscData} />
    )}

    {content && content.sources.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
          <h2 class="text-lg sm:text-xl font-semibold">Authoritative Sources</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Key guidance documents from authoritative organizations. Click to view the original source.
        </p>
        <div class="grid gap-3 sm:gap-4 min-w-0">
          {content.sources.map((source) => (
            <AuthoritativeSourceCard source={source} client:load />
          ))}
        </div>
      </section>
    )}

    {/* GitHub repos */}
    {githubRepoData.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          <h2 class="text-lg sm:text-xl font-semibold">Open Source Tools</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Community and open-source tools for {tech.name}.
        </p>
        <div class="grid gap-3 sm:gap-4">
          {githubRepoData.map((repo) => (
            <GitHubRepoCard {...repo} client:load />
          ))}
        </div>
      </section>
    )}

    {content && content.responsibilities.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <h2 class="text-lg sm:text-xl font-semibold">Customer Configuration Responsibilities</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Configuration tasks the customer owns in the shared responsibility model. Use the verification commands below to validate settings.
        </p>

        <div class="space-y-4">
          {content.responsibilities.map((respSection) => (
            <div class="rounded-lg border border-border bg-card p-4 space-y-3">
              <div>
                <h3 class="text-base font-semibold text-foreground">{respSection.title}</h3>
                {respSection.description && (
                  <p class="text-sm text-muted-foreground mt-1">{respSection.description}</p>
                )}
              </div>
              <div class="space-y-3">
                {respSection.items.map((item) => (
                  <div class="rounded-md border border-border/60 bg-muted/30 p-3 space-y-2">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                      <div>
                        <p class="text-sm font-medium text-foreground">{item.title}</p>
                        {item.description && (
                          <p class="text-xs text-muted-foreground mt-1">{item.description}</p>
                        )}
                      </div>
                      {item.controls && item.controls.length > 0 && (
                        <div class="flex flex-wrap gap-2 text-xs">
                          {item.controls.map((control) => (
                            <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary">
                              {control}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {commands.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
          </svg>
          <h2 class="text-lg sm:text-xl font-semibold">Verification Commands</h2>
        </div>
        <p class="text-sm text-muted-foreground">
          Commands and queries for testing and verifying security configurations.
        </p>
        <div class={hasCommandGroups ? 'space-y-6' : 'space-y-3'}>
          {hasCommandGroups ? (
            groupedCommands.map((group) => (
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-base font-semibold text-foreground">{group.label}</h3>
                  <span class="text-xs text-muted-foreground">
                    {group.commands.length} {group.commands.length === 1 ? 'command' : 'commands'}
                  </span>
                </div>
                <div class="space-y-3">
                  {group.commands.map((cmd) => (
                    <div class="rounded-lg border border-border bg-card overflow-hidden">
                      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-3 sm:px-4 py-2 bg-muted/50 border-b border-border">
                        <span class="text-sm text-foreground">{cmd.description}</span>
                        <span class={`px-2 py-0.5 text-xs font-medium rounded border ${COMMAND_TYPES[cmd.type].color}`}>
                          {COMMAND_TYPES[cmd.type].label}
                        </span>
                      </div>
                      <div class="relative">
                        <StaticCode code={cmd.command} language={techCommandLanguage(cmd.type)} />
                        <button
                          data-copy={cmd.command}
                          class="copy-btn absolute top-2 right-2 p-1.5 rounded bg-muted hover:bg-muted/80 text-muted-foreground hover:text-foreground transition-colors"
                          title="Copy to clipboard"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          ) : (
            content.commands.map((cmd) => (
              <div class="rounded-lg border border-border bg-card overflow-hidden">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-3 sm:px-4 py-2 bg-muted/50 border-b border-border">
                  <span class="text-sm text-foreground">{cmd.description}</span>
                  <span class={`px-2 py-0.5 text-xs font-medium rounded border ${COMMAND_TYPES[cmd.type].color}`}>
                    {COMMAND_TYPES[cmd.type].label}
                  </span>
                </div>
                <div class="relative">
                  <StaticCode code={cmd.command} language={techCommandLanguage(cmd.type)} />
                  <button
                    data-copy={cmd.command}
                    class="copy-btn absolute top-2 right-2 p-1.5 rounded bg-muted hover:bg-muted/80 text-muted-foreground hover:text-foreground transition-colors"
                    title="Copy to clipboard"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                    </svg>
                  </button>
                </div>
              </div>
            ))
          )}
        </div>
      </section>
    )}

    {content && content.controlMappings.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
          <h2 class="text-lg sm:text-xl font-semibold">Related Controls</h2>
        </div>
        <div class="space-y-4">
          {content.controlMappings.map((mapping) => {
            const frameworkConfig = getFrameworkConfig(mapping.frameworkId);
            if (!frameworkConfig) return null;
            const isLoaded = hasFrameworkData(mapping.frameworkId);

            return (
              <div class="rounded-lg border border-border bg-card p-3 sm:p-4">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-0 mb-3">
                  <a
                    href={`/frameworks/${mapping.frameworkId}`}
                    class="font-medium text-foreground hover:text-primary transition-colors"
                  >
                    {frameworkConfig.name}
                  </a>
                  <span class="text-xs text-muted-foreground">
                    {mapping.controlIds.length} {mapping.controlIds.length === 1 ? 'control' : 'controls'}
                    {!isLoaded && ' · External reference'}
                  </span>
                </div>
                <div class="flex flex-wrap gap-2">
                  {mapping.controlIds.map((controlId) => (
                    <a
                      href={isLoaded ? `/frameworks/${mapping.frameworkId}/${slugify(controlId)}` : `/frameworks/${mapping.frameworkId}`}
                      title={isLoaded ? undefined : `${frameworkConfig.name} ${controlId} (view official source & local overlay instructions)`}
                      class="px-2.5 py-1 text-sm rounded-md bg-muted hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      {controlId}
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {/* Prev/next section navigation */}
    {(prevSection || nextSection) && (
      <nav class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-border">
        {prevSection ? (
          <a
            href={`${techPath}/${prevSection.id}`}
            class="flex-1 group rounded-lg border border-border bg-card p-4 hover:border-primary/50 hover:bg-muted/30 transition-all"
          >
            <span class="text-xs text-muted-foreground">Previous</span>
            <div class="flex items-center gap-2 mt-1">
              <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              <span class="font-medium text-foreground group-hover:text-primary transition-colors">{prevSection.title}</span>
            </div>
          </a>
        ) : <div class="flex-1" />}
        {nextSection ? (
          <a
            href={`${techPath}/${nextSection.id}`}
            class="flex-1 group rounded-lg border border-border bg-card p-4 hover:border-primary/50 hover:bg-muted/30 transition-all text-right"
          >
            <span class="text-xs text-muted-foreground">Next</span>
            <div class="flex items-center justify-end gap-2 mt-1">
              <span class="font-medium text-foreground group-hover:text-primary transition-colors">{nextSection.title}</span>
              <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </a>
        ) : <div class="flex-1" />}
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  // Copy to clipboard functionality
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const svg = btn.querySelector('svg');
        if (svg) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />';
          setTimeout(() => {
            svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />';
          }, 1500);
        }
      }
    });
  });
</script>
