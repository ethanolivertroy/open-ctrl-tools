---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TechnologyCard } from '@/components/guidance/TechnologyCard';
import { getCategoryMeta, getTechnologiesByCategory } from '@/data/technology-guides';
import type { TechnologyCategory } from '@/data/types';

interface Props {
  categoryId: TechnologyCategory;
  title?: string;
  description?: string;
  intro?: string;
}

const { categoryId, title, description, intro } = Astro.props;

const categoryMeta = getCategoryMeta(categoryId);
const pageTitle = title ?? categoryMeta?.name ?? 'Technology Guidance';
const pageDescription = description ?? categoryMeta?.description ?? 'Technology-specific security guidance with authoritative sources and verification commands.';
const technologies = getTechnologiesByCategory(categoryId);
---

<BaseLayout
  title={`${pageTitle} Guidance`}
  description={pageDescription}
  showSidebar={false}
>
  <div class="space-y-8 sm:space-y-10">
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground flex-wrap">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href="/guidance" class="hover:text-foreground transition-colors">Technology Guidance</a>
        <span>/</span>
        <span class="text-foreground">{pageTitle}</span>
      </nav>

      <div class="flex items-center gap-3">
        {categoryMeta && (
          <div class="p-2 rounded-lg bg-primary/10">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={categoryMeta.icon} />
            </svg>
          </div>
        )}
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">
          {pageTitle}
        </h1>
      </div>

      <p class="text-muted-foreground max-w-2xl text-lg">
        {pageDescription}
      </p>

      {intro && (
        <div class="flex items-start gap-3 p-4 rounded-lg border border-border bg-muted/30 text-sm">
          <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="space-y-1">
            <p class="font-medium text-foreground">What you'll find here</p>
            <p class="text-muted-foreground">
              {intro}
            </p>
          </div>
        </div>
      )}

      <div class="p-4 rounded-lg warning-banner">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 warning-banner-icon shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <p class="text-sm warning-banner-text">
            <strong>Under Construction:</strong> This guidance is being actively developed and verified. Content may change.
          </p>
        </div>
      </div>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg sm:text-xl font-semibold">Guides</h2>
          <p class="text-sm text-muted-foreground">
            {technologies.length === 0
              ? 'No guides available yet.'
              : `${technologies.length} ${technologies.length === 1 ? 'guide' : 'guides'} in this section.`}
          </p>
        </div>
      </div>

      {technologies.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2">
          {technologies.map((tech) => (
            <TechnologyCard technology={tech} client:load />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 text-muted-foreground">
          <p>More guidance is coming soon.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
