---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  count?: number;
  highlights?: string[];
}

const {
  title,
  description,
  href,
  icon,
  count,
  highlights = [],
} = Astro.props;

const visibleHighlights = highlights.slice(0, 4);
---

<a
  href={href}
  class="group block rounded-xl border border-border bg-card p-5 transition-all hover:border-primary/50 hover:bg-muted/50"
>
  <div class="flex items-start gap-3">
    <div class="p-2 rounded-lg bg-muted text-foreground">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
      </svg>
    </div>
    <div class="space-y-1">
      <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
        {title}
      </h3>
      <p class="text-sm text-muted-foreground">
        {description}
      </p>
    </div>
  </div>

  {(count !== undefined || visibleHighlights.length > 0) && (
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      {count !== undefined && (
        <span class="px-2.5 py-1 rounded-full bg-muted text-muted-foreground">
          {count} {count === 1 ? 'guide' : 'guides'}
        </span>
      )}
      {visibleHighlights.map((item) => (
        <span class="px-2.5 py-1 rounded-full bg-primary/10 text-primary">
          {item}
        </span>
      ))}
    </div>
  )}
</a>
