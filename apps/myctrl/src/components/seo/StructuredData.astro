---
import { REPO_URL } from '../../lib/site-links';

interface Props {
  type: 'organization' | 'webpage' | 'breadcrumb';
  title?: string;
  description?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { type, title, description, breadcrumbs } = Astro.props;
const siteUrl = 'https://myctrl.tools';

// Generate JSON-LD based on type
function generateSchema() {
  switch (type) {
    case 'organization':
      return {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'myctrl.tools',
        url: siteUrl,
        logo: `${siteUrl}/icon-512.png`,
        description: 'Your security compliance command center. Browse 120+ frameworks, get implementation guidance, explore crosswalks, and build AI-powered compliance workflows.',
        sameAs: [REPO_URL]
      };

    case 'webpage':
      return {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description: description,
        url: Astro.url.href,
        isPartOf: {
          '@type': 'WebSite',
          name: 'myctrl.tools',
          url: siteUrl
        }
      };

    case 'breadcrumb':
      if (!breadcrumbs?.length) return null;
      return {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url.startsWith('http') ? item.url : `${siteUrl}${item.url}`
        }))
      };

    default:
      return null;
  }
}

const schema = generateSchema();
---

{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
