---
import BaseLayout from '../../layouts/BaseLayout.astro';

const author = {
  name: 'Ethan Troy',
  role: 'Security Research & Development · GRC Engineering · AI',
  bio: 'Ethan builds tools at the intersection of security, compliance, and AI. myctrl.tools grew out of the frustration of navigating dozens of framework PDFs and spreadsheets: he wanted a single place to search, compare, and assess controls across every major standard.',
  image: '/img/author.png',
  links: {
    github: 'https://github.com/ethanolivertroy',
    linkedin: 'https://www.linkedin.com/in/ethantroy/',
    x: 'https://twitter.com/ethanolivertroy',
    medium: 'https://medium.com/@ethanolivertroy',
    youtube: 'https://youtube.com/@hackidle',
  },
};

const features = [
  {
    title: '80+ Built-In Open Frameworks',
    description: 'Public-domain and permissive open-license standards (NIST, FedRAMP, CMMC, EU AI Act, OWASP) plus official links & local overlay support for commercial frameworks.',
    icon: 'library',
    color: 'blue',
  },
  {
    title: 'Cross-Framework Mappings',
    description: 'Explore how controls map across frameworks with interactive crosswalk visualizations.',
    icon: 'git-compare',
    color: 'lavender',
  },
  {
    title: 'Gap Analysis',
    description: 'Assess compliance readiness against FedRAMP, FedRAMP 20x, CMMC, and DoD SRG baselines (plus AIUC-1 via local overlay) with GRCLanker.',
    icon: 'check-circle',
    color: 'green',
  },
  {
    title: 'Privacy-First',
    description: 'All your data stays in your browser. No accounts, no tracking, no server-side storage.',
    icon: 'shield',
    color: 'amber',
  },
];

const audience = [
  {
    title: 'Security & compliance professionals',
    description: 'who need fast access to control catalogs without navigating PDFs or spreadsheets.',
  },
  {
    title: 'GRC analysts',
    description: 'performing gap assessments and crosswalk mapping between frameworks.',
  },
  {
    title: 'Engineers and auditors',
    description: 'looking for quick reference to specific controls and their requirements.',
  },
  {
    title: 'AI safety teams',
    description: 'navigating emerging AI governance frameworks like NIST AI RMF, EU AI Act, and AIUC-1.',
  },
];

const techStack = [
  { name: 'Astro', url: 'https://astro.build', color: 'text-orange-400' },
  { name: 'React', url: 'https://react.dev', color: 'text-blue-400' },
  { name: 'Tailwind CSS', url: 'https://tailwindcss.com', color: 'text-cyan-400' },
];

const socialIcons = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  x: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  medium: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.846 6.887c.03-.295-.083-.586-.303-.784l-2.24-2.7v-.403h6.958l5.378 11.795 4.728-11.795h6.633v.403l-1.917 1.837c-.165.126-.247.333-.213.538v13.498c-.034.204.048.411.213.537l1.871 1.837v.403h-9.412v-.403l1.937-1.882c.19-.19.19-.246.19-.537v-10.91l-5.39 13.688h-.725l-6.275-13.688v9.174c-.052.385.076.774.347 1.054l2.521 3.058v.404h-7.148v-.404l2.521-3.058c.27-.28.399-.669.348-1.054v-10.91z"/></svg>`,
  youtube: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
};

const featureIcons = {
  library: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>`,
  'git-compare': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="18" r="3"/><circle cx="12" cy="6" r="3"/><path d="M7 20v-6h10v6"/><path d="M7 4v6h10V4"/></svg>`,
  'check-circle': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>`,
  shield: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
};
---

<BaseLayout title="About" showSidebar={false}>
  <div class="max-w-5xl mx-auto py-12 px-4">
    <!-- Header with Breadcrumb -->
    <header class="space-y-4 mb-12">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">About</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight">
        About myctrl.tools
      </h1>
      <p class="text-muted-foreground max-w-2xl">
        A free reference for browsing and comparing security and compliance frameworks.
      </p>
    </header>

    <!-- Sub-Navigation -->
    <nav class="flex gap-2 mb-12 pb-4 border-b border-border/50">
      <a
        href="/about"
        class="px-4 py-2 text-sm font-medium rounded-lg bg-primary text-primary-foreground transition-colors"
      >
        About myctrl.tools
      </a>
      <a
        href="/about/user-data"
        class="px-4 py-2 text-sm font-medium rounded-lg bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground transition-colors"
      >
        User Data & Privacy
      </a>
    </nav>

    <!-- Author Section (Compact Horizontal) -->
    <section class="glass-card rounded-2xl p-6 mb-16">
      <div class="flex flex-col sm:flex-row gap-6 items-start">
        <div class="flex-shrink-0">
          <img
            src={author.image}
            alt={author.name}
            width={112}
            height={112}
            loading="lazy"
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover border border-border/50"
          />
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
            <div>
              <h2 class="text-xl font-bold">{author.name}</h2>
              <p class="text-sm text-muted-foreground">{author.role}</p>
            </div>
            <div class="flex items-center gap-2">
              {Object.entries(author.links).map(([platform, url]) => (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-muted/50 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
                  title={platform.charAt(0).toUpperCase() + platform.slice(1)}
                >
                  <Fragment set:html={socialIcons[platform as keyof typeof socialIcons]} />
                </a>
              ))}
            </div>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {author.bio}
          </p>
        </div>
      </div>
    </section>

    <!-- What is Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">What is myctrl.tools?</h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-lg text-foreground/90 leading-relaxed">
          myctrl.tools is a static site that lets you browse <strong>80+ built-in public-domain and open-license security frameworks</strong> (from NIST 800-53 and FedRAMP to CMMC and the EU AI Act) alongside an external publisher directory for commercial standards that you can load locally. Search across frameworks, compare controls side by side, explore public-domain crosswalks, and run gap assessments against baselines.
        </p>
      </div>
    </section>

    <!-- Who is it for Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">Who is it for?</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {audience.map((item) => (
          <div class="flex gap-3 p-4 rounded-xl bg-muted/30 border border-border/30">
            <div class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-primary mt-2" />
            <div>
              <h3 class="font-medium text-foreground mb-1">{item.title}</h3>
              <p class="text-sm text-muted-foreground">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Key Features Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">Key Features</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {features.map((feature) => (
          <div class={`glass-card feature-card feature-${feature.color} group overflow-hidden rounded-xl border p-5`}>
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="feature-icon w-5 h-5 flex-shrink-0">
                  <Fragment set:html={featureIcons[feature.icon as keyof typeof featureIcons]} />
                </div>
                <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">
                  {feature.title}
                </h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Built With Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">Built With</h2>
      <div class="prose prose-invert max-w-none">
        <p class="text-foreground/90">
          myctrl.tools is built with {techStack.map((tech, i) => (
            <>
              <a href={tech.url} class={`${tech.color} hover:underline`} target="_blank" rel="noopener noreferrer">
                {tech.name}
              </a>
              {i < techStack.length - 1 ? (i === techStack.length - 2 ? ', and ' : ', ') : '.'}
            </>
          ))} Framework data for built-in standards is sourced from public-domain and permissive open-license publications and stored as JSON; proprietary and restricted frameworks link to their official publishers and can be loaded into your gitignored local overlay (<code>src/data/local/</code>).
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="glass-card rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold mb-3">Want to know how your data is handled?</h2>
      <p class="text-sm text-muted-foreground mb-6 max-w-lg mx-auto">
        Learn about our privacy-first approach and how all data stays in your browser.
      </p>
      <a
        href="/about/user-data"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
      >
        User Data & Privacy
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  /* Section number styling (from homepage) */




  /* Card surface (from homepage) */
  .glass-card {
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 20%, transparent);
    background: var(--ctp-mantle);
    transition: border-color 0.2s ease-out;
  }

  .glass-card:hover {
    border-color: color-mix(in srgb, var(--ctp-overlay0) 40%, transparent);
  }

  /* Feature card color variants */
  .feature-card {
    position: relative;
    overflow: hidden;
  }

  .category-glow {
    display: none;
  }

  .feature-icon {
    color: var(--category-accent);
  }

  .feature-blue {
    --category-accent: var(--ctp-blue);
  }

  .feature-lavender {
    --category-accent: var(--ctp-lavender);
  }

  .feature-green {
    --category-accent: var(--ctp-green);
  }

  .feature-amber {
    --category-accent: var(--ctp-peach);
  }
</style>
