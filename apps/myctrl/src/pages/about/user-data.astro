---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_SOURCE_URL } from '../../lib/site-links';

const dataTypes = [
  {
    title: 'Filter Presets',
    description: 'Saved combinations of framework filters and search queries.',
    storage: 'IndexedDB / Dexie',
    icon: 'filter',
  },
  {
    title: 'Favorites',
    description: 'Starred frameworks with your personal notes.',
    storage: 'IndexedDB / Dexie',
    icon: 'star',
  },
  {
    title: 'Control Notes',
    description: 'Per-control notes and annotations.',
    storage: 'IndexedDB / Dexie',
    icon: 'note',
  },
  {
    title: 'Recently Viewed',
    description: 'Last 20 frameworks or controls you visited.',
    storage: 'IndexedDB / Dexie',
    icon: 'clock',
  },
];

const features = [
  {
    title: 'Browser-Only',
    description: 'Your data never leaves your device.',
    icon: 'laptop',
    color: 'green',
  },
  {
    title: 'No Cookies',
    description: 'We don\'t use tracking cookies or analytics that identify you.',
    icon: 'cookie-off',
    color: 'lavender',
  },
  {
    title: 'You Control It',
    description: 'Export or delete your data anytime from the Preferences page.',
    icon: 'user-control',
    color: 'blue',
  },
  {
    title: 'Open Source',
    description: 'The code is public. Verify the claims yourself.',
    icon: 'code',
    color: 'amber',
  },
];

const icons = {
  filter: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>`,
  star: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  note: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  laptop: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.3 1.3a1 1 0 0 1 .7.7v.6a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-.6a1 1 0 0 1 .7-.7L3 16"/></svg>`,
  'cookie-off': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="m2 2 20 20"/><path d="M8.5 8.5A3.5 3.5 0 0 0 6 12c0 2.5 1.5 4 3 5"/><circle cx="12" cy="15" r="1"/><circle cx="16" cy="9" r="1"/><circle cx="9" cy="14" r="1"/></svg>`,
  'user-control': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m21 11-3-3 3-3"/><path d="M18 11h-3"/></svg>`,
  code: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
};
---

<BaseLayout title="User Data & Privacy" showSidebar={false}>
  <div class="max-w-5xl mx-auto py-12 px-4">
    <!-- Header with Breadcrumb -->
    <header class="space-y-4 mb-12">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href="/about" class="hover:text-foreground transition-colors">About</a>
        <span>/</span>
        <span class="text-foreground">User Data & Privacy</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight">
        User Data & Privacy
      </h1>
      <p class="text-muted-foreground max-w-2xl">
        How we handle your data, and why you can trust that it stays private.
      </p>
    </header>

    <!-- Sub-Navigation -->
    <nav class="flex gap-2 mb-12 pb-4 border-b border-border/50">
      <a
        href="/about"
        class="px-4 py-2 text-sm font-medium rounded-lg bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground transition-colors"
      >
        About myctrl.tools
      </a>
      <a
        href="/about/user-data"
        class="px-4 py-2 text-sm font-medium rounded-lg bg-primary text-primary-foreground transition-colors"
      >
        User Data & Privacy
      </a>
    </nav>

    <!-- Overview Section -->
    <section class="mb-16">
      <div class="glass-card rounded-2xl p-8">
        <div class="flex items-start gap-4 mb-6">
          <div class="p-3 rounded-xl bg-green-500/10 text-green-400 flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h2 class="text-xl font-bold mb-2">Privacy-First by Design</h2>
            <p class="text-foreground/90 leading-relaxed">
              <strong>Everything is stored in your browser.</strong> Your favorites, notes, assessments, and preferences are saved locally using IndexedDB through Dexie, not on our servers. This means:
            </p>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/30">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-foreground/80">No accounts or passwords needed</span>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/30">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-foreground/80">No personal data collection</span>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/30">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-foreground/80">No third-party tracking</span>
          </div>
          <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/30">
            <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm text-foreground/80">Full control over your data</span>
          </div>
        </div>
      </div>
    </section>

    <!-- What Data is Stored Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">What Data is Stored</h2>

      <div class="grid sm:grid-cols-2 gap-4">
        {dataTypes.map((item) => (
          <div class="glass-card rounded-xl p-5 border border-border/30">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-lg bg-muted/50 flex items-center justify-center text-muted-foreground">
                <Fragment set:html={icons[item.icon as keyof typeof icons]} />
              </div>
              <h3 class="font-semibold text-foreground">{item.title}</h3>
            </div>
            <p class="text-sm text-muted-foreground mb-3">{item.description}</p>
            <div class="flex items-center gap-2 text-xs">
              <span class="px-2 py-1 rounded bg-primary/10 text-primary">{item.storage}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Privacy Features Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">Privacy Features</h2>

      <div class="grid md:grid-cols-2 gap-4">
        {features.map((feature) => (
          <div class={`glass-card feature-card feature-${feature.color} group overflow-hidden rounded-xl border p-5`}>
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="feature-icon w-5 h-5 flex-shrink-0">
                  <Fragment set:html={icons[feature.icon as keyof typeof icons]} />
                </div>
                <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">
                  {feature.title}
                </h3>
              </div>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {feature.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Data Management Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold tracking-tight border-t border-dashed border-border/40 pt-6 mb-6">Manage Your Data</h2>

      <div class="glass-card rounded-2xl p-6 border border-border/30">
        <p class="text-foreground/90 mb-6">
          You have full control over your data. Visit the Preferences page to export your data as JSON or clear everything from your browser.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href="/preferences"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            Open Preferences
          </a>
          <a
            href={SITE_SOURCE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            View Source Code
          </a>
        </div>
      </div>
    </section>

    <!-- Back to About Section -->
    <section class="glass-card rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold mb-3">Want to learn more about the project?</h2>
      <p class="text-sm text-muted-foreground mb-6 max-w-lg mx-auto">
        Read about the features, goals, and what makes myctrl.tools different.
      </p>
      <a
        href="/about"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium rounded-lg bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        About myctrl.tools
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  /* Section number styling (from homepage) */




  /* Card surface (from homepage) */
  .glass-card {
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 20%, transparent);
    background: var(--ctp-mantle);
    transition: border-color 0.2s ease-out;
  }

  .glass-card:hover {
    border-color: color-mix(in srgb, var(--ctp-overlay0) 40%, transparent);
  }

  /* Feature card color variants */
  .feature-card {
    position: relative;
    overflow: hidden;
  }

  .category-glow {
    display: none;
  }

  .feature-icon {
    color: var(--category-accent);
  }

  .feature-green {
    --category-accent: var(--ctp-green);
  }

  .feature-lavender {
    --category-accent: var(--ctp-lavender);
  }

  .feature-blue {
    --category-accent: var(--ctp-blue);
  }

  .feature-amber {
    --category-accent: var(--ctp-peach);
  }
</style>
