---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AIViewBuilder } from '../components/ai/AIViewBuilder';
import { SavedViewsList } from '../components/ai/SavedViewsList';

// Get prompt from URL if present (for shareable links)
const url = new URL(Astro.request.url);
const initialPrompt = url.searchParams.get('prompt') || undefined;
const initialSavedViewId = url.searchParams.get('savedView') || undefined;
---

<BaseLayout
  title="AI View Builder"
  description="Create custom compliance views using natural language. Describe what you want to see and let AI compose the perfect view."
  showSidebar={false}
>
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <!-- Page Header -->
    <header class="text-center space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/30 text-primary text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
        <span>AI-Powered</span>
      </div>

      <h1 class="text-4xl font-bold tracking-tight">
        Build Custom Compliance Views
      </h1>

      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Describe what you want to see in natural language. The AI will compose a view
        with the right controls, frameworks, and comparisons.
      </p>
    </header>

    <!-- AI View Builder -->
    <AIViewBuilder client:load initialPrompt={initialPrompt} initialSavedViewId={initialSavedViewId} />

    <!-- Saved Views Section -->
    <section class="mt-12">
      <SavedViewsList client:load />
    </section>

    <!-- Help Section -->
    <section class="mt-16 space-y-6">
      <h2 class="text-xl font-semibold text-center">How It Works</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">1</span>
          </div>
          <h3 class="font-medium">Describe Your Need</h3>
          <p class="text-sm text-muted-foreground">
            Tell the AI what compliance information you're looking for in plain English.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">2</span>
          </div>
          <h3 class="font-medium">AI Composes View</h3>
          <p class="text-sm text-muted-foreground">
            The AI selects relevant controls, frameworks, and creates appropriate visualizations.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="text-center space-y-3">
          <div class="w-12 h-12 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">3</span>
          </div>
          <h3 class="font-medium">Refine & Export</h3>
          <p class="text-sm text-muted-foreground">
            Refine the results with follow-up prompts or export the view for your documentation.
          </p>
        </div>
      </div>
    </section>

    <!-- Tips Section -->
    <section class="mt-12 p-6 rounded-lg border border-border bg-card">
      <h3 class="font-semibold mb-4">Tips for Better Results</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="text-foreground">Be specific:</strong> "FedRAMP Moderate access control" works better than "access controls"</span>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="text-foreground">Mention frameworks:</strong> Reference specific frameworks like NIST, FedRAMP, ISO, or CMMC</span>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="text-foreground">Ask for comparisons:</strong> "Compare NIST 800-53 and ISO 27001 encryption controls"</span>
        </li>
        <li class="flex items-start gap-2">
          <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="text-foreground">Enable "Include my data":</strong> Get personalized views based on your favorites and history</span>
        </li>
      </ul>
    </section>

    <!-- Privacy Note -->
    <section class="mt-8 text-center">
      <p class="text-xs text-muted-foreground">
        Your prompts are processed by Claude AI. When "Include my data" is enabled,
        your favorites and recent views are shared to personalize results.
        <a href="/privacy" class="text-primary hover:underline ml-1">Learn more</a>
      </p>
    </section>
  </div>
</BaseLayout>
