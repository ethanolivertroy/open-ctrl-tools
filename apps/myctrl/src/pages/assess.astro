---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AssessmentDashboard } from '../components/assessment/AssessmentDashboard';
---

<BaseLayout title="Gap Analysis" showSidebar={false}>
  <div class="max-w-[1600px] mx-auto space-y-6 py-8 px-4">
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">Gap Analysis</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight">
        Gap Analysis
      </h1>

      <p class="text-muted-foreground max-w-2xl">
        Assess your compliance readiness against built-in public-domain baselines (FedRAMP Rev 5,
        FedRAMP 20x KSI, CMMC 2.0, and DoD SRG) — plus AIUC-1 when loaded into your local overlay.
        Track implementation status, leverage cross-framework mappings, capture CMVP cryptographic
        module inventory, and generate executive-ready reports. All free, all in your browser.
      </p>
    </header>

    <AssessmentDashboard client:load />
  </div>
</BaseLayout>
