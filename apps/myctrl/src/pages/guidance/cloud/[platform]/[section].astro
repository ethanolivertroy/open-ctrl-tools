---
import TechGuideSectionPage from '@/components/guidance/TechGuideSectionPage.astro';
import {
  getTechnologiesByCategory,
  getTechnologyById,
  getCategoryMeta,
} from '@/data/technology-guides';

export function getStaticPaths() {
  const paths: { params: { platform: string; section: string } }[] = [];
  for (const tech of getTechnologiesByCategory('cloud')) {
    if (tech.sections) {
      for (const section of tech.sections) {
        paths.push({ params: { platform: tech.id, section: section.id } });
      }
    }
  }
  return paths;
}

const { platform, section: sectionId } = Astro.params;
const tech = getTechnologyById(platform);

if (!tech || tech.category !== 'cloud' || !tech.sections) {
  return Astro.redirect('/guidance/cloud');
}

const section = tech.sections.find((s) => s.id === sectionId);
if (!section) {
  return Astro.redirect(`/guidance/cloud/${platform}`);
}

const categoryMeta = getCategoryMeta('cloud');
---

<TechGuideSectionPage tech={tech} section={section} categoryMeta={categoryMeta} categoryHref={categoryMeta?.path} />
