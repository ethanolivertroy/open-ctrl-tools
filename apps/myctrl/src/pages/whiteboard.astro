---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { WhiteboardApp } from '../components/whiteboard/WhiteboardApp';
---

<BaseLayout title="Whiteboard" showSidebar={false}>
  <div class="min-h-screen bg-zinc-950 -mx-4 sm:-mx-6 -my-8">
    <!-- Header -->
    <header class="border-b border-zinc-800 bg-zinc-900/50">
      <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2 text-sm text-zinc-500 mb-1">
              <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
              <span>/</span>
              <span class="text-zinc-300">Whiteboard</span>
            </div>
            <h1 class="text-2xl font-bold text-zinc-100">
              <span class="text-primary">{'>'}</span> Whiteboard
            </h1>
            <p class="text-sm text-zinc-400 mt-1">
              Sketch diagrams, map controls, and plan your compliance posture
            </p>
          </div>

          <a
            href="/"
            class="px-3 py-1.5 text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg border border-zinc-700 transition-colors"
          >
            ← Back
          </a>
        </div>
      </div>
    </header>

    <!-- Whiteboard -->
    <main>
      <WhiteboardApp client:only="react" />
    </main>
  </div>
</BaseLayout>
