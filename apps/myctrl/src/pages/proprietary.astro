---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStats, getByLicense } from '../data/controls';
import FrameworkCard from '../components/cards/FrameworkCard.astro';

const proprietaryConfigs = getByLicense('proprietary');
const proprietaryContent = proprietaryConfigs.map(config => ({
  config,
  stats: getStats(config.id),
}));

const totalItems = proprietaryContent.reduce((sum, { stats }) => sum + stats.total, 0);
---

<BaseLayout title="Proprietary Standards" showSidebar={false}>
  <div class="max-w-4xl mx-auto space-y-12 py-12">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">Proprietary</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="badge-proprietary px-3 py-1.5 text-sm font-mono rounded border">
          Proprietary
        </span>
        <h1 class="text-3xl font-bold tracking-tight">
          Proprietary Standards
        </h1>
      </div>

      <p class="text-muted-foreground max-w-2xl">
        Security frameworks and standards owned by private organizations.
        Full control text is not redistributed here; each entry links to the official publisher
        and explains how to load a licensed copy locally for your own use.
        {totalItems > 0
          ? ` ${totalItems.toLocaleString()} locally loaded items across ${proprietaryContent.length} resource${proprietaryContent.length !== 1 ? 's' : ''}.`
          : ` ${proprietaryContent.length} external reference${proprietaryContent.length !== 1 ? 's' : ''}.`}
      </p>
    </header>

    <!-- Proprietary Content Cards -->
    <section class="space-y-6">
      <div class="grid gap-6">
        {proprietaryContent.map(({ config, stats }, i) => (
          <FrameworkCard config={config} stats={stats} index={i} />
        ))}
      </div>

      {proprietaryContent.length === 0 && (
        <p class="text-center text-muted-foreground py-8">
          No proprietary content available yet.
        </p>
      )}
    </section>

    <!-- Info Section -->
    <section class="glass-card-thick p-6 rounded-lg border space-y-4">
      <h2 class="text-lg font-semibold flex items-center gap-2">
        <span class="text-primary font-mono">{'>'}</span>
        About Proprietary Standards
      </h2>
      <div class="text-sm text-muted-foreground space-y-3">
        <p>
          <strong class="text-foreground">Proprietary standards</strong> are owned by private organizations and subject to copyright restrictions.
          Redistribution of full content typically requires licensing or purchase.
        </p>
        <p>
          This directory provides:
        </p>
        <ul class="list-disc list-inside pl-2 space-y-1">
          <li>Direct links to official copyright-holder publications</li>
          <li>Public-domain cross-framework ID mappings where available (e.g., NIST OLIR)</li>
          <li>A gitignored local overlay (<code>src/data/local/&lt;id&gt;.json</code>) and Agent Skill (<code>skills/myctrl-local-standards/SKILL.md</code>) so you can load your own licensed standards locally without redistributing them</li>
        </ul>
        <p>
          For complete control requirements, implementation guidance, and testing procedures, please obtain the official standards directly from the respective organizations.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
