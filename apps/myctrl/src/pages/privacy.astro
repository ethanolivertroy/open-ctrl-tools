---
import FrameworkCategoryPage from '../components/frameworks/FrameworkCategoryPage.astro';
import { getStats, getFrameworkConfig } from '../data/controls';

// Privacy frameworks grouped by jurisdiction
const jurisdictions = {
  'U.S. Federal': ['hipaa-security', 'us-dpf', 'fipps'],
  'U.S. State': ['ccpa', 'nv-reg5', 'or-cpa', 'tn-ipa', 'tx-cdpa', 'va-cdpa'],
  'International': ['gdpr', 'india-dpdpa', 'sa-pdpl', 'apec-privacy', 'oecd-privacy'],
  'Standards': ['iso-27701', 'iso-29100', 'dpmp'],
};

const groups = Object.entries(jurisdictions).map(([jurisdiction, ids]) => ({
  heading: jurisdiction,
  frameworks: ids.flatMap(id => {
    try {
      return [{ config: getFrameworkConfig(id), stats: getStats(id) }];
    } catch {
      return [];
    }
  }),
})).filter(g => g.frameworks.length > 0);

const allFrameworks = groups.flatMap(g => g.frameworks);
const totalItems = allFrameworks.reduce((sum, fw) => sum + (fw.stats.total || 0), 0);
const description =
  `Data protection and privacy regulations from around the world. ` +
  `${totalItems.toLocaleString()} items across ${allFrameworks.length} framework${allFrameworks.length !== 1 ? 's' : ''}.`;
---

<FrameworkCategoryPage
  title="Privacy Frameworks"
  breadcrumbLabel="Privacy"
  heading="Privacy Frameworks"
  badge={{ label: 'Privacy', class: 'bg-amber-500/10 border-amber-500/30 text-amber-700 dark:text-amber-400' }}
  description={description}
  groups={groups}
>
  <section slot="info" class="p-4 rounded-lg border border-border bg-card/50">
    <div class="flex gap-3">
      <svg class="w-5 h-5 text-muted-foreground shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <div class="text-sm text-muted-foreground">
        <p>
          Privacy frameworks establish requirements for protecting personal data, managing consent, and ensuring individuals' rights over their information.
          These range from comprehensive regulations like GDPR to sector-specific standards like HIPAA.
        </p>
      </div>
    </div>
  </section>
</FrameworkCategoryPage>
