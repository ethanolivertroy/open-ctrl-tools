---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CrosswalkTable } from '../../components/crosswalk/CrosswalkTable';
import { getAllCrosswalkEntries, getCrosswalkMetadata } from '../../data/crosswalk';

const entries = getAllCrosswalkEntries();
const metadata = getCrosswalkMetadata();
---

<BaseLayout title="CSF 2.0 ↔ NIST 800-53 Crosswalk" showSidebar={false}>
  <div class="max-w-6xl mx-auto space-y-8 py-12 px-4">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href="/crosswalk" class="hover:text-foreground transition-colors">Crosswalk</a>
        <span>/</span>
        <span class="text-foreground">CSF ↔ NIST 800-53</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight">
        CSF 2.0 ↔ NIST 800-53 Crosswalk
      </h1>

      <p class="text-muted-foreground max-w-2xl">
        Official NIST mapping between Cybersecurity Framework 2.0 subcategories and
        NIST SP 800-53 Rev 5 security controls.
        <span class="font-mono text-sm">{metadata.total_mappings.toLocaleString()}</span> mappings
        connecting <span class="font-mono text-sm">{metadata.csf_subcategories}</span> CSF subcategories
        to <span class="font-mono text-sm">{metadata.nist_controls}</span> NIST controls.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs font-mono">
          <span class="text-primary">CSF</span>
          <span class="opacity-70">v{metadata.csf_version}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs font-mono">
          <span class="text-primary">800-53</span>
          <span class="opacity-70">r{metadata.nist_version}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground">
          Draft
        </span>
      </div>
    </header>

    <!-- Crosswalk Table -->
    <section>
      <CrosswalkTable entries={entries} client:load />
    </section>

    <!-- Source Attribution -->
    <footer class="pt-8 border-t border-border">
      <p class="text-sm text-muted-foreground">
        Source: {metadata.source}
      </p>
    </footer>
  </div>
</BaseLayout>
