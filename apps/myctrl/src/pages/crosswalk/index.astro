---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCrosswalkMetadata, getCSFPCICrosswalkMetadata } from '../../data/crosswalk';

const nistMetadata = getCrosswalkMetadata();
const pciMetadata = getCSFPCICrosswalkMetadata();
---

<BaseLayout title="Cross-Framework Mappings" showSidebar={false}>
  <div class="max-w-4xl mx-auto space-y-8 py-12 px-4">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">Crosswalks</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight">
        Cross-Framework Mappings
      </h1>

      <p class="text-muted-foreground max-w-2xl">
        Official NIST public-domain and OLIR ID mappings between security and compliance frameworks.
        Supply optional licensed crosswalk JSONs in <code>src/data/local/crosswalks/</code> to extend local analysis.
      </p>
    </header>

    <!-- Visualize CTA -->
    <a
      href="/crosswalk/visualize"
      class="group flex items-center justify-between p-4 rounded-lg border glass-card hover:border-primary/30 transition-all scroll-reveal"
    >
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-primary/10">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3" stroke-width="2"/>
            <circle cx="5" cy="6" r="2" stroke-width="2"/>
            <circle cx="19" cy="6" r="2" stroke-width="2"/>
            <circle cx="5" cy="18" r="2" stroke-width="2"/>
            <circle cx="19" cy="18" r="2" stroke-width="2"/>
            <path d="M9.5 10.5L6.5 7.5M14.5 10.5L17.5 7.5M9.5 13.5L6.5 16.5M14.5 13.5L17.5 16.5" stroke-width="1.5"/>
          </svg>
        </div>
        <div>
          <div class="font-medium group-hover:text-primary transition-colors">
            Interactive Visualizer
          </div>
          <div class="text-sm text-muted-foreground">
            Explore framework relationships with network graphs and heatmaps
          </div>
        </div>
      </div>
      <svg class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- Crosswalk Cards -->
    <section class="grid gap-6 md:grid-cols-2">
      <!-- CSF ↔ NIST 800-53 -->
      <a href="/crosswalk/csf-nist" class="group block p-6 rounded-2xl border glass-card hover:border-primary/50 hover:scale-[1.01] transition-all scroll-reveal">
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-0.5 text-xs font-mono">
              <span class="text-primary">CSF 2.0</span>
            </span>
            <span class="text-muted-foreground">↔</span>
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-0.5 text-xs font-mono">
              <span class="text-primary">800-53 r5</span>
            </span>
          </div>

          <h2 class="text-xl font-semibold group-hover:text-primary transition-colors">
            CSF 2.0 ↔ NIST 800-53
          </h2>

          <p class="text-sm text-muted-foreground">
            {nistMetadata.total_mappings.toLocaleString()} mappings between {nistMetadata.csf_subcategories} CSF subcategories
            and {nistMetadata.nist_controls} NIST controls.
          </p>

          <div class="text-xs text-muted-foreground/70">
            Draft mapping from NIST
          </div>
        </div>
      </a>

      <!-- CSF ↔ PCI-DSS -->
      <a href="/crosswalk/csf-pci" class="group block p-6 rounded-2xl border glass-card hover:border-primary/50 hover:scale-[1.01] transition-all scroll-reveal">
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-0.5 text-xs font-mono">
              <span class="text-primary">CSF 2.0</span>
            </span>
            <span class="text-muted-foreground">↔</span>
            <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-0.5 text-xs font-mono">
              <span class="text-primary">PCI-DSS 4.0.1</span>
            </span>
          </div>

          <h2 class="text-xl font-semibold group-hover:text-primary transition-colors">
            CSF 2.0 ↔ PCI-DSS v4.0.1
          </h2>

          <p class="text-sm text-muted-foreground">
            {pciMetadata.total_mappings.toLocaleString()} mappings between {pciMetadata.csf_subcategories} CSF subcategories
            and {pciMetadata.pci_requirements} PCI-DSS requirements.
          </p>

          <div class="text-xs text-muted-foreground/70">
            NIST OLIR supportive mapping
          </div>
        </div>
      </a>
    </section>

    <!-- Info -->
    <section class="pt-8 border-t border-border">
      <p class="text-sm text-muted-foreground">
        Cross-framework ID mappings are also displayed on individual control detail pages
        under the "Cross-Framework Mappings" section. Local crosswalk overlays dropped into
        <code>src/data/local/crosswalks/</code> are picked up automatically at build and test time.
      </p>
    </section>
  </div>
</BaseLayout>
