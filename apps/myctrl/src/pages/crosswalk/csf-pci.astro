---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CSFPCICrosswalkTable } from '../../components/crosswalk/CSFPCICrosswalkTable';
import { getAllCSFPCICrosswalkEntries, getCSFPCICrosswalkMetadata } from '../../data/crosswalk';

const entries = getAllCSFPCICrosswalkEntries();
const metadata = getCSFPCICrosswalkMetadata();
---

<BaseLayout title="CSF 2.0 ↔ PCI-DSS v4.0.1 Crosswalk" showSidebar={false}>
  <div class="max-w-6xl mx-auto space-y-8 py-12 px-4">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <a href="/crosswalk" class="hover:text-foreground transition-colors">Crosswalk</a>
        <span>/</span>
        <span class="text-foreground">CSF ↔ PCI-DSS</span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight">
        CSF 2.0 ↔ PCI-DSS v4.0.1 Crosswalk
      </h1>

      <p class="text-muted-foreground max-w-2xl">
        NIST OLIR mapping between Cybersecurity Framework 2.0 subcategories and
        PCI DSS v4.0.1 requirements.
        <span class="font-mono text-sm">{metadata.total_mappings.toLocaleString()}</span> mappings
        connecting <span class="font-mono text-sm">{metadata.csf_subcategories}</span> CSF subcategories
        to <span class="font-mono text-sm">{metadata.pci_requirements}</span> PCI requirements.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs font-mono">
          <span class="text-primary">CSF</span>
          <span class="opacity-70">v{metadata.csf_version}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs font-mono">
          <span class="text-primary">PCI-DSS</span>
          <span class="opacity-70">v{metadata.pci_version}</span>
        </span>
      </div>
    </header>

    <!-- Crosswalk Table -->
    <section>
      <CSFPCICrosswalkTable entries={entries} client:load />
    </section>

    <!-- Source Attribution -->
    <footer class="pt-8 border-t border-border space-y-2">
      <p class="text-sm text-muted-foreground">
        Source: {metadata.source}
      </p>
      <p class="text-xs text-muted-foreground">
        Note: PCI DSS requirement links forward to the PCI DSS v4.0.1 overview page with official PCI SSC source links and local overlay instructions, unless you supply your licensed dataset in <code>src/data/local/pci-dss-v4.json</code>.
      </p>
    </footer>
  </div>
</BaseLayout>
