---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CrosswalkWorkbench } from '../../components/crosswalk/CrosswalkWorkbench';
import { getCrosswalkStats } from '../../data/crosswalk-stats';

export const prerender = true;

const stats = getCrosswalkStats();
const frameworkCount = stats.nodes.length;
const totalRelationships = stats.edges.reduce((sum, edge) => sum + edge.mappingCount, 0);
---

<BaseLayout
  title="Crosswalk Workbench"
  description="Interactive security framework coverage matrix and control crosswalk explorer."
  showSidebar={false}
>
  <div class="container mx-auto px-4 py-8 max-w-7xl space-y-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-border/60 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full border border-primary/30 bg-primary/10 text-primary text-xs font-mono">
          CROSSWALK WORKBENCH
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">
          Cross-Framework Mapping &amp; Coverage
        </h1>
        <p class="text-sm text-muted-foreground max-w-2xl">
          Inspect bi-directional control overlap across loaded security frameworks, inspect coverage percentages, or explore single-control mappings without loading heavyweight graph scripts upfront.
        </p>
      </div>

      <div class="flex items-center gap-3 font-mono text-xs text-muted-foreground">
        <div class="px-3 py-1.5 rounded-lg border border-border bg-card/60">
          <span class="text-foreground font-semibold">{frameworkCount}</span> mapped frameworks
        </div>
        <div class="px-3 py-1.5 rounded-lg border border-border bg-card/60">
          <span class="text-foreground font-semibold">{totalRelationships.toLocaleString()}</span> mappings
        </div>
      </div>
    </div>

    <CrosswalkWorkbench client:load />
  </div>
</BaseLayout>
