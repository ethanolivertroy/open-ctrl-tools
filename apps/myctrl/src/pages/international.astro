---
import FrameworkCategoryPage from '../components/frameworks/FrameworkCategoryPage.astro';
import { getStats, getFrameworkConfig } from '../data/controls';

// International frameworks grouped by region
const regions = {
  'Americas': ['canada-itsp', 'canada-osfi-b13', 'itsg-33'],
  'Asia-Pacific': ['au-essential-8', 'au-ism', 'china-csl', 'india-dpdpa', 'india-sebi', 'nz-hisf', 'nz-hisf-suppliers', 'apec-privacy'],
  'Europe': ['spain-ens', 'uk-caf', 'uk-defstan', 'oecd-privacy'],
  'Middle East': ['sa-iot', 'sa-pdpl', 'uae-niaf'],
  'Global Standards': ['iec-60601', 'imo-maritime', 'sparta'],
};

const groups = Object.entries(regions).map(([region, ids]) => ({
  heading: region,
  frameworks: ids.flatMap(id => {
    try {
      return [{ config: getFrameworkConfig(id), stats: getStats(id) }];
    } catch {
      return [];
    }
  }),
})).filter(g => g.frameworks.length > 0);

const allFrameworks = groups.flatMap(g => g.frameworks);
const totalItems = allFrameworks.reduce((sum, fw) => sum + (fw.stats.total || 0), 0);
const description =
  `Security and privacy frameworks from regulatory bodies around the world. ` +
  `${totalItems.toLocaleString()} items across ${allFrameworks.length} framework${allFrameworks.length !== 1 ? 's' : ''}.`;
---

<FrameworkCategoryPage
  title="International Frameworks"
  breadcrumbLabel="International"
  heading="International Frameworks"
  badge={{ label: 'International', class: 'bg-cyan-500/10 border-cyan-500/30 text-cyan-700 dark:text-cyan-400' }}
  description={description}
  groups={groups}
>
  <section slot="info" class="p-4 rounded-lg border border-border bg-card/50">
    <div class="flex gap-3">
      <svg class="w-5 h-5 text-muted-foreground shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div class="text-sm text-muted-foreground">
        <p>
          These frameworks represent cybersecurity and data protection requirements from various countries and international organizations.
          Cross-framework mappings link them to NIST, ISO, and other major frameworks.
        </p>
      </div>
    </div>
  </section>
</FrameworkCategoryPage>
