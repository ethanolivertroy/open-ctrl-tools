---
/**
 * Offline fallback, served by the service worker when a navigation fails and
 * the page was never cached. Deliberately standalone: no layout, no islands,
 * no external assets, so it renders from the cache alone.
 */
export const prerender = true;

const savedPages = [
  { href: '/', label: 'Home' },
  { href: '/all/', label: 'All frameworks' },
  { href: '/assess/', label: 'Assessments' },
  { href: '/crosswalk/visualize/', label: 'Crosswalk workbench' },
  { href: '/compare/', label: 'Compare frameworks' },
  { href: '/guidance/', label: 'Implementation guidance' },
];
---

<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Offline | myctrl.tools</title>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dracula' || theme === 'latte') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {
          // Storage can be unavailable; the default theme is fine.
        }
      })();
    </script>
    <style is:inline>
      :root {
        --base: #1e1e2e;
        --mantle: #181825;
        --text: #cdd6f4;
        --muted: #a6adc8;
        --border: #45475a;
        --accent: #cba6f7;
        --on-accent: #1e1e2e;
      }
      [data-theme='dracula'] {
        --base: #282a36;
        --mantle: #21222c;
        --text: #f8f8f2;
        --muted: #c5c8d6;
        --border: #44475a;
        --accent: #bd93f9;
        --on-accent: #282a36;
      }
      [data-theme='latte'] {
        --base: #eff1f5;
        --mantle: #e6e9ef;
        --text: #4c4f69;
        --muted: #6c6f85;
        --border: #bcc0cc;
        --accent: #8839ef;
        --on-accent: #eff1f5;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: var(--base);
        color: var(--text);
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
      }
      main {
        width: 100%;
        max-width: 32rem;
      }
      .brand {
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .brand span {
        color: var(--accent);
      }
      h1 {
        margin: 1.5rem 0 0.5rem;
        font-size: 1.75rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }
      p {
        margin: 0 0 1.5rem;
        color: var(--muted);
      }
      button {
        font: inherit;
        font-weight: 500;
        padding: 0.6rem 1.1rem;
        border: 0;
        border-radius: 0.5rem;
        background: var(--accent);
        color: var(--on-accent);
        cursor: pointer;
      }
      h2 {
        margin: 2rem 0 0.75rem;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: var(--mantle);
        overflow: hidden;
      }
      li + li {
        border-top: 1px solid var(--border);
      }
      a {
        display: block;
        padding: 0.7rem 1rem;
        color: var(--text);
        text-decoration: none;
      }
      a:hover,
      a:focus-visible {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">myctrl<span>.tools</span></div>
      <h1>You're offline</h1>
      <p>
        This page hasn't been saved for offline use yet. Pages you've already opened are still
        available, and the rest will load once you're back online.
      </p>
      <button type="button" onclick="location.reload()">Try again</button>

      <h2>Saved for offline</h2>
      <ul>
        {savedPages.map((page) => (
          <li>
            <a href={page.href}>{page.label}</a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
