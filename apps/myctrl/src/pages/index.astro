---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CosmosBackground } from '../components/hero/CosmosBackground';
import { SkyControls } from '../components/hero/SkyControls';
import { HeroSearch } from '../components/hero/HeroSearch';
import {
  getLoadedFrameworkIds,
  getExternalFrameworkIds,
  getFrameworkConfig,
  getStats,
  getBasePath,
} from '../data/controls';
import { getCrosswalkStats } from '../data/crosswalk-stats';

export const prerender = true;

const loadedIds = getLoadedFrameworkIds();
const externalIds = getExternalFrameworkIds();
const crosswalkStats = getCrosswalkStats();
const totalCrosswalkRelationships = crosswalkStats.edges.reduce((sum, edge) => sum + edge.mappingCount, 0);

let totalLoadedItems = 0;
const loadedSummaries = loadedIds.map((id) => {
  const config = getFrameworkConfig(id);
  const stats = getStats(id);
  totalLoadedItems += stats.total;
  return {
    id,
    name: config.name,
    version: config.version,
    total: stats.total,
    itemLabel: config.itemLabel,
    href: `${getBasePath(id)}/${id}`,
  };
});

const featuredIds = [
  'nist-800-53-r5',
  'nist-csf-v2',
  'fedramp-rev5',
  'fedramp-20x-ksi',
  'cmmc-v2',
  'owasp-web-top10',
  'owasp-llm-top10',
  'eu-ai-act',
];

const featuredChips = featuredIds
  .filter((id) => loadedIds.includes(id))
  .map((id) => loadedSummaries.find((f) => f.id === id)!)
  .filter(Boolean);

const domains = [
  {
    code: '01',
    title: 'US Federal & GovCloud',
    subtitle: 'NIST 800-53, FedRAMP Rev 5 & 20x KSI, CMMC 2.0, DoD SRG, TX-RAMP',
    href: '/us-federal',
    badge: 'Public Domain',
  },
  {
    code: '02',
    title: 'AI Governance & Safety',
    subtitle: 'EU AI Act, NIST AI RMF, OWASP LLM Top 10 & Agentic Security',
    href: '/ai',
    badge: 'AI / ML',
  },
  {
    code: '03',
    title: 'OWASP & AppSec',
    subtitle: 'OWASP ASVS v5, Web & API Top 10, Mobile Top 10, LLM & Agentic Security',
    href: '/owasp',
    badge: 'Engineering',
  },
  {
    code: '04',
    title: 'Privacy & Risk',
    subtitle: 'NIST Privacy Framework, NIST CSF 2.0, CIS Controls & Exposure Management',
    href: '/privacy',
    badge: 'Governance',
  },
  {
    code: '05',
    title: 'International & ISO',
    subtitle: 'ISO/IEC 27001, 27002, 27701, NIS2, DORA & Global Regulatory Baselines',
    href: '/international',
    badge: 'Global',
  },
  {
    code: '06',
    title: 'Implementation Guidance',
    subtitle: 'Cloud baselines, STIG overlays, CMVP crypto modules & programmatic queries',
    href: '/guidance',
    badge: 'Technical',
  },
];

const workbenches = [
  {
    title: 'Assessment Workbench',
    desc: 'Interactive self-assessments stored in local IndexedDB with readiness scoring and gap exports.',
    href: '/assess',
    tag: 'Local-First',
  },
  {
    title: 'Crosswalk Workbench',
    desc: 'Inspect bi-directional control overlap across loaded frameworks and trace single-control mappings.',
    href: '/crosswalk/visualize',
    tag: 'Matrix',
  },
  {
    title: 'Framework Diff',
    desc: 'Compare control baselines, impact levels, and crosswalk coverage side-by-side.',
    href: '/compare',
    tag: 'Compare',
  },
  {
    title: 'GRCLanker Chat + Voice',
    desc: 'BYOK AI copilot and full-duplex speech-to-speech audit interview practice (OpenAI, Grok, Gemini, Browser).',
    href: '#voice',
    tag: 'Voice + Chat',
    triggerVoice: true,
  },
];
---

<BaseLayout
  title="Security Compliance Command Center"
  description="Browse security frameworks, control baselines, crosswalk matrices, self-assessments, and speech-to-speech AI compliance copilot."
  showSidebar={false}
  isHomepage={true}
>
  {/* Deep-space backdrop: fixed behind the whole page, composed around the hero */}
  <CosmosBackground client:idle slot="background" />

  {/* Command-center hero; the planet rises beside the copy */}
  <section
    data-cosmos-anchor
    class="relative min-h-[540px] lg:min-h-[min(44rem,calc(100svh-6rem))] flex items-center"
  >
    <SkyControls client:idle />

    <div class="relative z-10 container mx-auto px-4 pt-16 pb-24 sm:py-16 md:py-24 max-w-6xl">
      <div data-cosmos-copy class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-card/75 backdrop-blur-md px-3 py-1 text-xs font-mono text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true"></span>
          <span>
            {loadedSummaries.length} loaded catalogs · {totalLoadedItems.toLocaleString()} controls ·{' '}
            {totalCrosswalkRelationships.toLocaleString()} crosswalk links
          </span>
        </div>

        <h1 class="cosmos-legible text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight leading-[1.08]">
          Security controls,{' '}
          <span class="text-primary">mapped &amp; searchable</span>{' '}
          without the bloat.
        </h1>

        <p class="cosmos-legible text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">
          Instant navigation across NIST 800-53, FedRAMP 20x KSI, CSF 2.0, CMMC 2.0, OWASP ASVS, and the EU AI Act — paired with local-first assessments and speech-to-speech audit practice.
        </p>

        <HeroSearch client:load />

        {/* Quick jump chips — strictly loaded datasets */}
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-muted-foreground mr-1">
            Loaded:
          </span>
          {featuredChips.map((fw) => (
            <a
              href={fw.href}
              class="inline-flex items-center gap-1.5 rounded-lg border border-border/70 bg-card/70 hover:border-primary/50 hover:bg-card px-2.5 py-1 text-xs transition-colors"
            >
              <span class="font-medium text-foreground">{fw.name}</span>
              <span class="font-mono text-[11px] text-muted-foreground">{fw.total}</span>
            </a>
          ))}
          <a
            href="/all"
            class="inline-flex items-center gap-1 rounded-lg border border-dashed border-border hover:border-primary/50 px-2.5 py-1 text-xs font-mono text-primary transition-colors"
          >
            All {loadedSummaries.length + externalIds.length} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Domain index */}
  <section class="container mx-auto px-4 py-14 max-w-6xl space-y-6">
    <div class="flex items-end justify-between gap-4 border-b border-border/50 pb-4">
      <div>
        <div class="text-xs font-mono uppercase tracking-widest text-primary">Catalog</div>
        <h2 class="text-2xl font-semibold tracking-tight mt-1">Compliance Domains</h2>
      </div>
      <a href="/all" class="text-xs font-mono text-muted-foreground hover:text-primary transition-colors">
        Browse full directory ({loadedSummaries.length} loaded · {externalIds.length} external) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {domains.map((d) => (
        <a
          href={d.href}
          class="glass-card group rounded-xl border border-border/70 p-5 hover:border-primary/50 transition-all flex flex-col justify-between gap-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-muted-foreground">{d.code}</span>
              <span class="px-2 py-0.5 text-[11px] font-mono rounded border border-border/80 bg-muted/40 text-muted-foreground">
                {d.badge}
              </span>
            </div>
            <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
              {d.title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {d.subtitle}
            </p>
          </div>
          <div class="text-xs font-mono text-primary/80 group-hover:text-primary flex items-center gap-1">
            <span>Explore domain</span>
            <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Workbenches strip */}
  <section class="border-t border-border/60 bg-card/30">
    <div class="container mx-auto px-4 py-14 max-w-6xl space-y-6">
      <div>
        <div class="text-xs font-mono uppercase tracking-widest text-primary">Workbenches</div>
        <h2 class="text-2xl font-semibold tracking-tight mt-1">Engineering &amp; Audit Tools</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {workbenches.map((tool) =>
          tool.triggerVoice ? (
            <button
              type="button"
              data-ai-chat-trigger
              data-ai-tab="voice"
              data-ai-voice-mode="copilot"
              class="glass-card glass-card-accent text-left group rounded-xl border border-primary/30 p-5 hover:border-primary/60 transition-all flex flex-col justify-between gap-4"
            >
              <div class="space-y-2">
                <span class="inline-block px-2 py-0.5 text-[11px] font-mono rounded border border-primary/30 bg-primary/10 text-primary">
                  {tool.tag}
                </span>
                <h3 class="text-base font-semibold group-hover:text-primary transition-colors">
                  {tool.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {tool.desc}
                </p>
              </div>
              <span class="text-xs font-mono text-primary">Launch Voice &rarr;</span>
            </button>
          ) : (
            <a
              href={tool.href}
              class="glass-card group rounded-xl border border-border/70 p-5 hover:border-primary/50 transition-all flex flex-col justify-between gap-4"
            >
              <div class="space-y-2">
                <span class="inline-block px-2 py-0.5 text-[11px] font-mono rounded border border-border/80 bg-muted/40 text-muted-foreground">
                  {tool.tag}
                </span>
                <h3 class="text-base font-semibold group-hover:text-primary transition-colors">
                  {tool.title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {tool.desc}
                </p>
              </div>
              <span class="text-xs font-mono text-primary/80 group-hover:text-primary">
                Open &rarr;
              </span>
            </a>
          ),
        )}
      </div>
    </div>
  </section>
</BaseLayout>
