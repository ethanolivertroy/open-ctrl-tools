---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStats, getByTag, getRiskLists, getFrameworks } from '../data/controls';
import { FRAMEWORK_CONFIGS } from '../data/frameworks';
import { HeroSearch } from '../components/hero/HeroSearch';
import { WebGLBackground } from '../components/hero/WebGLBackground';
import TechGuidancePreview from '../components/hero/TechGuidancePreview.astro';
import AIPreview from '../components/hero/AIPreview.astro';

// Calculate category stats
const federalConfigs = getByTag('Federal');
const aiConfigs = getByTag('AI');
const internationalConfigs = getByTag('International');
const privacyConfigs = getByTag('Privacy');

const allFrameworks = getFrameworks();
const allRiskLists = getRiskLists();
const catalogItems = [...allFrameworks, ...allRiskLists];
const totalItems = catalogItems.reduce((sum, c) => sum + getStats(c.id).total, 0);
const frameworkCount = catalogItems.length;
const loadedFrameworkCount = catalogItems.filter((c) => getStats(c.id).total > 0).length;
// Category data (4 primary categories - Enterprise/OWASP accessible via header dropdowns)
const categories = [
  {
    id: 'federal',
    title: 'U.S. Federal',
    description: 'NIST, FedRAMP, DoD security frameworks for government compliance',
    href: '/us-federal',
    color: 'blue',
    count: federalConfigs.reduce((sum, c) => sum + getStats(c.id).total, 0),
    frameworkCount: federalConfigs.length,
    featured: ['NIST 800-53', 'FedRAMP', 'NIST CSF'],
  },
  {
    id: 'ai',
    title: 'AI & Machine Learning',
    description: 'AI risk management, governance, and security frameworks',
    href: '/ai',
    color: 'lavender',
    count: aiConfigs.reduce((sum, c) => sum + getStats(c.id).total, 0),
    frameworkCount: aiConfigs.length,
    featured: ['NIST AI RMF', 'EU AI Act', 'OWASP LLM'],
  },
  {
    id: 'privacy',
    title: 'Privacy',
    description: 'Data protection and privacy regulations worldwide',
    href: '/privacy',
    color: 'amber',
    count: privacyConfigs.reduce((sum, c) => sum + getStats(c.id).total, 0),
    frameworkCount: privacyConfigs.length,
    featured: ['GDPR', 'HIPAA', 'CCPA'],
  },
  {
    id: 'international',
    title: 'International',
    description: 'Global security frameworks from regulatory bodies worldwide',
    href: '/international',
    color: 'cyan',
    count: internationalConfigs.reduce((sum, c) => sum + getStats(c.id).total, 0),
    frameworkCount: internationalConfigs.length,
    featured: ['Australia ISM', 'UK CAF', 'Canada ITSP'],
  },
];

// SVG Icons for each category (from Lucide)
const icons = {
  federal: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 18v-7"/>
    <path d="M11.12 2.198a2 2 0 0 1 1.76.006l7.866 3.847c.476.233.31.949-.22.949H3.474c-.53 0-.695-.716-.22-.949z"/>
    <path d="M14 18v-7"/>
    <path d="M18 18v-7"/>
    <path d="M3 22h18"/>
    <path d="M6 18v-7"/>
  </svg>`,
  ai: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
    <path d="M9 13a4.5 4.5 0 0 0 3-4"/>
    <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/>
    <path d="M3.477 10.896a4 4 0 0 1 .585-.396"/>
    <path d="M6 18a4 4 0 0 1-1.967-.516"/>
    <path d="M12 13h4"/>
    <path d="M12 18h6a2 2 0 0 1 2 2v1"/>
    <path d="M12 8h8"/>
    <path d="M16 8V5a2 2 0 0 1 2-2"/>
    <circle cx="16" cy="13" r=".5"/>
    <circle cx="18" cy="3" r=".5"/>
    <circle cx="20" cy="21" r=".5"/>
    <circle cx="20" cy="8" r=".5"/>
  </svg>`,
  international: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/>
    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
    <path d="M2 12h20"/>
  </svg>`,
  privacy: `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
  </svg>`,
};
---

<BaseLayout title="Home" showSidebar={false} isHomepage={true}>
  <!-- Full-page WebGL background (position: fixed, sits behind all content).
       client:idle keeps the Three.js bundle off the critical hydration path;
       the canvas fades in on its first rendered frame anyway. -->
  <WebGLBackground client:idle />

  <div class="max-w-5xl mx-auto space-y-24 md:space-y-32 px-4">
    <!-- Hero Section -->
    <section class="relative pt-16 pb-24 md:pt-24 md:pb-32 text-center flex flex-col items-center justify-center min-h-[85vh]">

      <div class="relative space-y-6 max-w-5xl mx-auto w-full">
        <!-- Headline -->
        <h1 class="hero-heading font-bold tracking-tight leading-[1.05] animate-fade-in-up" style="animation-delay: 0ms; animation-fill-mode: both;">
          myctrl<span class="text-primary">.tools</span> are now<br class="hidden sm:block" /> <em class="not-italic text-primary relative inline-block">your</em> control tools
        </h1>

        <!-- HeroSearch - primary CTA -->
        <div class="pt-4 animate-fade-in-up" style="animation-delay: 150ms; animation-fill-mode: both;">
          <HeroSearch client:load />
        </div>

      </div>

      <!-- Supported Frameworks: real links, not decoration -->
      <div class="relative mt-16 sm:mt-24 max-w-3xl mx-auto w-full animate-fade-in-up" style="animation-delay: 300ms; animation-fill-mode: both;">
        <nav aria-label="Popular frameworks" class="flex flex-wrap justify-center items-baseline gap-x-7 gap-y-3 font-mono text-[0.7rem] uppercase tracking-[0.14em]">
          {[
            { name: 'NIST 800-53', href: '/frameworks/nist-800-53-r5' },
            { name: 'SOC 2', href: '/frameworks/soc2-tsc' },
            { name: 'FedRAMP', href: '/frameworks/fedramp-rev5' },
            { name: 'ISO 27001', href: '/frameworks/iso-27001-2022' },
            { name: 'PCI DSS', href: '/frameworks/pci-dss-v4' },
            { name: 'HIPAA', href: '/frameworks/hipaa-security' },
            { name: 'GDPR', href: '/frameworks/gdpr' },
            { name: 'CIS', href: '/frameworks/cis-controls-v8' },
            { name: 'CMMC', href: '/frameworks/cmmc-v2' },
            { name: 'AI RMF', href: '/frameworks/nist-ai-rmf' },
          ].map(({ name, href }) => (
            <a href={href} class="text-muted-foreground hover:text-foreground transition-colors duration-300">{name}</a>
          ))}
        </nav>

        <div class="mt-8 text-center">
          <a
            href="/all"
            class="inline-flex items-center gap-2 rounded-md border border-border/60 px-5 py-2.5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-foreground hover:border-foreground/50 transition-colors duration-300"
          >
            Browse all {frameworkCount} frameworks
          </a>
        </div>
      </div>

      <!-- Visual divider -->
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
    </section>

    <!-- Category Bento -->
    <section class="space-y-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-semibold uppercase tracking-[0.04em]">Start where your obligations live</h2>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          {loadedFrameworkCount} built-in open frameworks plus {frameworkCount - loadedFrameworkCount} external publisher directories (load your own licensed copies locally). Each built-in control is searchable, crosswalked, and ready to implement.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-6 md:[grid-auto-flow:dense] gap-4" data-bento>
        {categories.map((category, index) => {
          const isWide = index === 0 || index === 3;
          return (
            <a
              href={category.href}
              class={`category-card category-${category.color} group block relative overflow-hidden rounded-xl border ${isWide ? 'md:col-span-4' : 'md:col-span-2'}`}
              data-bento-cell
            >
              <div class={`p-5 sm:p-6 flex flex-col justify-between gap-6 h-full ${isWide ? 'md:min-h-56' : 'md:min-h-56'}`}>
                <div class="space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="category-icon">
                      <Fragment set:html={icons[category.id]} />
                    </div>
                    <h3 class="text-xl font-bold tracking-tight">
                      {category.title}
                    </h3>
                  </div>
                  <p class="text-sm text-muted-foreground leading-relaxed max-w-md">
                    {category.description}
                  </p>
                </div>

                <div class="flex items-end justify-between gap-4">
                  <div>
                    <div class="font-mono text-4xl md:text-5xl font-medium tabular-nums tracking-tight text-foreground">
                      {category.count.toLocaleString()}
                    </div>
                    <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground mt-2">
                      controls in {category.frameworkCount} {category.frameworkCount === 1 ? 'framework' : 'frameworks'}
                    </div>
                  </div>
                  {isWide && (
                    <div class="hidden sm:flex flex-wrap justify-end gap-2">
                      {category.featured.map((name) => (
                        <span class="featured-badge px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-[0.08em] rounded-md border">
                          {name}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Scrubbed statement -->
    <section class="py-8 md:py-16" aria-label="What myctrl.tools covers">
      <p class="statement mx-auto max-w-4xl text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tighter leading-[1.15] text-center" data-statement>
        {`${totalItems.toLocaleString()} controls. ${loadedFrameworkCount} built-in open frameworks (${frameworkCount} in catalog). One lookup shows a control's equivalents, with the guidance to actually implement it.`.split(' ').map((word) => (
          <span class="statement-word inline-block">{word}&nbsp;</span>
        ))}
      </p>
    </section>

    <!-- Tools Section — tighter grouping between related previews -->
    <div class="space-y-12">
      <TechGuidancePreview />
      <AIPreview />
    </div>
  </div>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    gsap.registerPlugin(ScrollTrigger);

    // Card scale & fade entrances for the category bento
    const cells = gsap.utils.toArray<HTMLElement>('[data-bento-cell]');
    cells.forEach((cell, index) => {
      gsap.fromTo(
        cell,
        { opacity: 0, scale: 0.96, y: 16 },
        {
          opacity: 1,
          scale: 1,
          y: 0,
          duration: 0.6,
          ease: 'power3.out',
          delay: (index % 2) * 0.08,
          scrollTrigger: { trigger: cell, start: 'top 88%', once: true },
        },
      );
    });

    // Scrubbed statement: words sweep from 10% to full opacity as you scroll
    const statement = document.querySelector('[data-statement]');
    if (statement) {
      const words = statement.querySelectorAll('.statement-word');
      gsap.fromTo(
        words,
        { opacity: 0.1 },
        {
          opacity: 1,
          stagger: 0.35,
          ease: 'none',
          scrollTrigger: {
            trigger: statement,
            start: 'top 85%',
            end: 'center 45%',
            scrub: true,
          },
        },
      );
    }
  }
</script>

<style>
  .hero-heading {
    font-family: 'Geist', system-ui, -apple-system, sans-serif;
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    letter-spacing: -0.045em;
    font-weight: 620;
  }

  /* ── Hero search treatment ── */
  :global(.hero-search-glass) {
    background: var(--ctp-mantle);
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 25%, transparent);
    transition: border-color 0.2s ease-out;
  }

  :global(.hero-search-glass:hover),
  :global(.hero-search-glass:focus-within) {
    border-color: color-mix(in srgb, var(--ctp-text) 40%, transparent);
  }

  /* Category card — stark monochrome panel with a hairline border; the icon
     carries the only color, everything else is type and number */
  .category-card {
    border: 1px solid color-mix(in srgb, var(--ctp-overlay0) 22%, transparent);
    background: color-mix(in srgb, var(--ctp-mantle) 80%, transparent);
    transition: border-color 0.2s ease-out, background-color 0.2s ease-out;
    position: relative;
    overflow: hidden;
  }

  .category-card:hover {
    border-color: color-mix(in srgb, var(--ctp-text) 35%, transparent);
    background: var(--ctp-mantle);
  }

  .category-glow {
    display: none;
  }

  .category-icon {
    color: var(--category-accent);
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* Color variants */
  .category-blue {
    --category-accent: var(--ctp-blue);
  }

  .category-lavender {
    --category-accent: var(--ctp-lavender);
  }

  .category-cyan {
    --category-accent: var(--ctp-sky);
  }

  .category-amber {
    --category-accent: var(--ctp-peach);
  }

  /* Featured badge styling — hairline outline, no fill */
  .featured-badge {
    background: transparent;
    border-color: color-mix(in srgb, var(--ctp-overlay0) 35%, transparent);
    color: var(--ctp-subtext0);
  }

</style>
