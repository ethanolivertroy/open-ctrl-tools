---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStats, getByTag } from '../data/controls';
import FrameworkCard from '../components/cards/FrameworkCard.astro';

const stigConfigs = getByTag('STIG');
const stigContent = stigConfigs.map(config => ({
  config,
  stats: getStats(config.id),
}));

const totalItems = stigContent.reduce((sum, { stats }) => sum + stats.total, 0);
---

<BaseLayout title="DoD STIGs" showSidebar={false}>
  <div class="max-w-4xl mx-auto space-y-12 py-12">
    <!-- Header -->
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">STIGs</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="px-3 py-1.5 text-sm font-mono rounded border bg-orange-500/10 border-orange-500/30 text-orange-700 dark:text-orange-400">
          STIG
        </span>
        <h1 class="text-3xl font-bold tracking-tight">
          Security Technical Implementation Guides
        </h1>
      </div>

      <p class="text-muted-foreground max-w-2xl">
        DoD Security Technical Implementation Guides (STIGs) provide configuration standards for hardening systems.
        {totalItems} findings across {stigContent.length} STIG{stigContent.length !== 1 ? 's' : ''}.
      </p>
    </header>

    <!-- Info Banner -->
    <div class="p-4 rounded-lg border border-orange-500/30 bg-orange-500/5">
      <div class="flex gap-3">
        <svg class="w-5 h-5 text-orange-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-sm text-muted-foreground">
          <p class="font-medium text-foreground mb-1">About STIGs</p>
          <p>
            STIGs are developed by the Defense Information Systems Agency (DISA) and provide detailed configuration guidance.
            Each finding includes check procedures, remediation steps, and CCI references that map to NIST 800-53 controls.
          </p>
        </div>
      </div>
    </div>

    <!-- STIG Content Cards -->
    <section class="space-y-6">
      <div class="grid gap-6">
        {stigContent.map(({ config, stats }, i) => (
          <FrameworkCard config={config} stats={stats} index={i} />
        ))}
      </div>

      {stigContent.length === 0 && (
        <p class="text-center text-muted-foreground py-8">
          No STIGs available yet.
        </p>
      )}
    </section>

    <!-- Severity Legend -->
    <section class="p-6 rounded-lg border border-border bg-card space-y-4">
      <h2 class="text-lg font-semibold flex items-center gap-2">
        <span class="text-primary font-mono">{'>'}</span>
        STIG Severity Categories
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="flex items-start gap-3">
          <span class="px-2 py-1 text-xs font-mono rounded border bg-red-500/10 border-red-500/30 text-red-700 dark:text-red-400 shrink-0">
            CAT I
          </span>
          <div class="text-sm">
            <p class="font-medium text-foreground">High</p>
            <p class="text-muted-foreground">Vulnerabilities that allow attackers immediate system access or execution.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="px-2 py-1 text-xs font-mono rounded border bg-yellow-500/10 border-yellow-500/30 text-yellow-700 dark:text-yellow-400 shrink-0">
            CAT II
          </span>
          <div class="text-sm">
            <p class="font-medium text-foreground">Medium</p>
            <p class="text-muted-foreground">Vulnerabilities that provide information for further attacks or degrade security.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="px-2 py-1 text-xs font-mono rounded border bg-blue-500/10 border-blue-500/30 text-blue-700 dark:text-blue-400 shrink-0">
            CAT III
          </span>
          <div class="text-sm">
            <p class="font-medium text-foreground">Low</p>
            <p class="text-muted-foreground">Vulnerabilities that degrade security measures or administrative efficiency.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
