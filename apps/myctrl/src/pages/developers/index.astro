---
import BaseLayout from '../../layouts/BaseLayout.astro';

const internalApis = [
  {
    href: '/developers/api#public-api',
    title: 'Public REST API',
    eyebrow: 'myctrl.tools',
    description: 'Open /api/v1/* endpoints for frameworks, controls, crosswalks, guidance, and search.',
  },
];

const externalApis = [
  {
    href: '/guidance/nist-cmvp-api',
    title: 'Upstream NIST CMVP API',
    eyebrow: 'External API',
    description: 'Guide to the upstream static CMVP API, repository, OpenAPI document, and discovery resources used behind the in-product CMVP experience.',
  },
];

const developerResources = [
  {
    href: '/developers/api',
    title: 'Unified API Reference',
    eyebrow: 'Reference',
    description: 'Endpoint docs for the supported public /api/v1/* contract.',
  },
  {
    href: '/llms.txt',
    title: 'llms.txt',
    eyebrow: 'Discovery',
    description: 'LLM-facing index for the public site, framework markdown exports, and guidance references.',
  },
  {
    href: '/guidance',
    title: 'Technology Guidance',
    eyebrow: 'Reference',
    description: 'Implementation guidance pages that connect products, controls, verification commands, and external references.',
  },
];
---

<BaseLayout
  title="Developers"
  showSidebar={false}
  description="Developer hub for myctrl.tools APIs and upstream integration resources"
>
  <div class="max-w-5xl mx-auto space-y-10 py-12 px-4">
    <header class="space-y-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
        <span>/</span>
        <span class="text-foreground">Developers</span>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Developers</h1>
        <p class="max-w-3xl text-muted-foreground">
          Build against public myctrl.tools APIs and linked upstream API resources without hunting through separate pages.
          This hub keeps the supported product API contract, external CMVP references, and integration
          artifacts in one place.
        </p>
      </div>
    </header>

    <section class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-semibold tracking-tight">myctrl.tools APIs</h2>
          <p class="text-sm text-muted-foreground">Supported product APIs for compliance data, controls, crosswalks, guidance, and search.</p>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {internalApis.map((api) => (
          <a href={api.href} class="group rounded-xl border border-border p-5 transition-colors hover:border-primary/50">
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{api.eyebrow}</div>
              <h3 class="text-base font-semibold group-hover:text-primary transition-colors">{api.title}</h3>
              <p class="text-sm text-muted-foreground">{api.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">External APIs</h2>
        <p class="text-sm text-muted-foreground">Upstream API resources that power or complement the in-app experience.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {externalApis.map((api) => (
          <a href={api.href} class="group rounded-xl border border-border p-5 transition-colors hover:border-primary/50">
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{api.eyebrow}</div>
              <h3 class="text-base font-semibold group-hover:text-primary transition-colors">{api.title}</h3>
              <p class="text-sm text-muted-foreground">{api.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Developer Resources</h2>
        <p class="text-sm text-muted-foreground">Reference pages and machine-readable assets used during integrations.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {developerResources.map((resource) => (
          <a href={resource.href} class="group rounded-xl border border-border p-5 transition-colors hover:border-primary/50">
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">{resource.eyebrow}</div>
              <h3 class="text-base font-semibold group-hover:text-primary transition-colors">{resource.title}</h3>
              <p class="text-sm text-muted-foreground">{resource.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-xl border border-border p-5 space-y-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight">Access Model</h2>
        <p class="text-sm text-muted-foreground">
          The supported /api/v1/* surface is public and read-only. User workspace data stays in the browser through IndexedDB/Dexie.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 text-sm">
        <div class="space-y-1 rounded-lg bg-muted/40 p-4">
          <div class="text-xs text-muted-foreground uppercase tracking-wider">API</div>
          <div class="font-mono">No key required</div>
          <div class="text-xs text-muted-foreground">Read-only public data</div>
        </div>
        <div class="space-y-1 rounded-lg bg-muted/40 p-4">
          <div class="text-xs text-muted-foreground uppercase tracking-wider">Workspace Data</div>
          <div class="font-mono">IndexedDB</div>
          <div class="text-xs text-muted-foreground">Local to each browser</div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
