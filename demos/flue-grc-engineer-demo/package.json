{
  "name": "flue-grc-engineer-demo",
  "version": "1.0.0",
  "description": "A Flue GRC engineer demo agent for Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --config dist/wrangler.jsonc --env-file .env",
    "build": "flue build --target cloudflare && node scripts/patch-auth.mjs",
    "deploy": "npm run build && wrangler deploy --secrets-file .env"
  },
  "keywords": [
    "flue",
    "grc",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.14",
    "@flue/sdk": "^0.3.11",
    "agents": "^0.34.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@flue/cli": "^0.3.11",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.11",
    "basic-ftp": "^6.2.4",
    "minimatch": "^11.0.1",
    "undici": "^7.30.2"
  },
  "private": true
}
